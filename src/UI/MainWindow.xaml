<Window x:Class="AICollabHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AIDeck · 多 AI 协同中心"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="1220" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgCanvasBrush}" Foreground="#E6EDF7"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" Background="{DynamicResource BgCanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 一体式顶部标题与控制栏：支持拖拽移动、双击最大化 + 右上角标准三键 (最小化 / 最大化 / 关闭) -->
        <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="0,0,0,1" Padding="14,0,8,0"
                MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
            <Grid x:Name="HeaderBarGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="HeaderBrandCluster" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderBrandText" Text="AIDeck · 多 AI 协同中心" FontSize="14.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="NoWrap"/>
                    <Button x:Name="HeaderVersionBtn"
                            Style="{StaticResource ActionBtn}"
                            Padding="8,2"
                            Margin="0,0,6,0"
                            FontSize="11.5"
                            ToolTip="AIDeck 当前版本，点击检查更新"
                            Click="HeaderVersionBtn_Click">
                        <TextBlock x:Name="HeaderVersionText" Text="v1.9.14" FontSize="11.5" FontWeight="SemiBold" Foreground="#7DD3FC"/>
                    </Button>
                    <Button x:Name="HeaderUpdateBadgeBtn"
                            Visibility="Collapsed"
                            Style="{StaticResource AmberBtn}"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            FontSize="11.5"
                            Content="发现新版本"
                            ToolTip="检测到新版本，点击下载并重启，或打开发布页"
                            Click="HeaderUpdateBadgeBtn_Click"/>
                    <Border Visibility="Collapsed" Background="#152236" BorderBrush="#263B59" BorderThickness="1" CornerRadius="5" Padding="9,3" VerticalAlignment="Center"
                            ToolTip="所有工程目录、新旧对话框自动按当前总策略执行规则">
                        <TextBlock Text="所有项目与新旧对话通用" FontSize="11.5" Foreground="#7DD3FC"/>
                    </Border>
                </StackPanel>

                <!-- 保留隐藏引用供内部兼容，不在界面展示“选项目”限制 -->
                <ComboBox x:Name="ProjectCombo" Grid.Column="1" Visibility="Collapsed" SelectionChanged="ProjectCombo_SelectionChanged" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0">
                    <Button x:Name="EditProjBtn" Content="路径" Style="{StaticResource ActionBtn}" Padding="9,4" Click="EditProjBtn_Click"/>
                    <Button x:Name="NewProjBtn" Content="＋ 新建" Style="{StaticResource ActionBtn}" Padding="9,4" Margin="5,0,0,0" Click="NewProjBtn_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="WorkflowSwitchBtn"
                            Content="● 协同已开启"
                            Style="{StaticResource SuccessBtn}"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            ToolTip="一键开启或关闭多 AI 协同工作流。关闭后所有 AI 恢复原生独立工作模式"
                            Click="WorkflowSwitchBtn_Click"/>
                    <Button x:Name="ToggleFloatingBtn"
                            Content="悬浮窗: 开"
                            Style="{StaticResource ActionBtn}"
                            Padding="9,4"
                            Margin="0,0,6,0"
                            ToolTip="开启或关闭常驻桌面的置顶多 AI 实时监控悬浮窗"
                            Click="ToggleFloatingBtn_Click"/>
                    <Button x:Name="CloudRecTopBtn"
                            Content="云端推荐"
                            Style="{StaticResource ActionBtn}"
                            Padding="9,4"
                            Margin="0,0,6,0"
                            ToolTip="从云端拉取各 AI 模型最新能力评分并一键应用推荐配置"
                            Click="CloudRecTopBtn_Click"/>
                    <Button x:Name="TopOpenSettingsBtn"
                            Content="设置"
                            Style="{StaticResource ActionBtn}"
                            Padding="9,4"
                            Margin="0,0,10,0"
                            ToolTip="打开软件与个性化设置"
                            Click="TopOpenSettingsBtn_Click"/>

                    <!-- 分隔竖线 + 右上角窗口控制按钮组（最小化 / 最大化 / 关闭） -->
                    <Border Width="1" Height="18" Background="#263348" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Button x:Name="MinimizeToFloatBtn"
                            Content="─"
                            Style="{StaticResource WinCtrlBtn}"
                            ToolTip="最小化到系统托盘（任务栏不占位，桌面可保留悬浮窗）"
                            Click="MinimizeToFloatBtn_Click"/>
                    <Button x:Name="MaximizeRestoreBtn"
                            Content="□"
                            Style="{StaticResource WinCtrlBtn}"
                            ToolTip="最大化 / 还原窗口"
                            Click="MaximizeRestoreBtn_Click"/>
                    <Button x:Name="TopCloseWindowBtn"
                            Content="✕"
                            Style="{StaticResource WinCloseBtn}"
                            ToolTip="关闭主窗口（默认弹窗询问：最小化到托盘 / 退出软件）"
                            Click="TopCloseWindowBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体区：左侧极简导航栏 + 右侧内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="0,0,1,0" Padding="10,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="监控与协作" Foreground="{StaticResource FgMutedBrush}" FontSize="11" Margin="10,0,0,6"/>
                        <RadioButton x:Name="NavOverview" Content="协同工作台" Style="{StaticResource NavBtn}" GroupName="MainNav" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDialogs" Content="对话与派单" Style="{StaticResource NavBtn}" GroupName="MainNav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSync" Content="规则与技能" Style="{StaticResource NavBtn}" GroupName="MainNav" Checked="Nav_Checked"/>

                        <Border Height="1" Background="{DynamicResource DividerRowBrush}" Margin="8,12"/>
                        <TextBlock Text="配置与管理" Foreground="{StaticResource FgMutedBrush}" FontSize="11" Margin="10,0,0,6"/>
                        <RadioButton x:Name="NavOps" Content="快照与任务单" Style="{StaticResource NavBtn}" GroupName="MainNav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Content="AI 阵容与路由" Style="{StaticResource NavBtn}" GroupName="MainNav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavAppSettings" Content="软件设置" Style="{StaticResource NavBtn}" GroupName="MainNav" Checked="Nav_Checked"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0">
                            <StackPanel>
                                <TextBlock x:Name="SidebarWorkflowBadge" Text="● 协同运行中" Foreground="#34D399" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NetworkHealthBadge" Text="● 网络在线 · 自动重连" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="McpBadgeText" Text="就绪" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AiChatRootBadge" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧 6 个功能页容器 -->
            <Grid Grid.Column="1" Margin="18,14,18,14">

                <!-- ==================== PAGE 1: 协同工作台 ==================== -->
                <ScrollViewer x:Name="PageOverview" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 顶部：单行清爽主脑统筹条 -->
                        <Border x:Name="OverviewTopBannerCard" Style="{StaticResource SectionCard}" Padding="16,11" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Border x:Name="OverviewModeBadge" Background="#12352C" BorderBrush="#1D6B55" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="OverviewModeBadgeText" Text="运行中" FontSize="11.5" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                                    </Border>
                                    <TextBlock x:Name="OverviewMasterBrainText"
                                               Text="主脑 AI：Antigravity · 全入口接单分析、按工作定位路由并执行验收闭环"
                                               FontSize="12.5" Foreground="#CBD5E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="阵容与路由" Style="{StaticResource ActionBtn}" Padding="9,3" FontSize="12" Margin="0,0,6,0" Click="JumpToSettingsBtn_Click"/>
                                    <Button x:Name="OverviewRefreshBtn" Content="刷新" Style="{StaticResource ActionBtn}" Padding="9,3" FontSize="12" Click="OverviewRefreshBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 断线/中断任务链断点续跑提示横幅（仅在存在未完成断点时自动浮现） -->
                        <Border x:Name="InterruptedCheckpointBanner" Visibility="Collapsed"
                                Style="{StaticResource SectionCard}" Background="#241911" BorderBrush="#9A5B1A" BorderThickness="1" Margin="0,0,0,14" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CheckpointBannerTitle"
                                               Text="检测到暂停的任务链断点（进度已保护）"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#FDBA74"/>
                                    <TextBlock x:Name="CheckpointBannerDetail"
                                               Text=""
                                               FontSize="11.5" Foreground="#CBD5E1" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="BtnChooseCheckpointResolution" Content="🛠 选择解决方式" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0" Click="BtnChooseCheckpointResolution_Click"/>
                                    <Button x:Name="BtnResumeCheckpoint" Content="断点续跑" Style="{StaticResource AmberBtn}" Margin="0,0,6,0" Click="BtnResumeCheckpoint_Click"/>
                                    <Button x:Name="BtnDismissCheckpoint" Content="忽略" Style="{StaticResource ActionBtn}" Click="BtnDismissCheckpoint_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- 当前工作流动态流程运行图（全宽，位于断点横幅下方、中部双栏上方） -->
                        <Border x:Name="WorkflowDiagramCard" Style="{StaticResource SectionCard}" Padding="14,10" Margin="0,0,0,14">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Ellipse x:Name="WorkflowDiagramStatusDot" Width="9" Height="9" Fill="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="当前工作流动态运行图" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border x:Name="WorkflowDiagramPhaseBadge" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="WorkflowDiagramPhaseBadgeText" Text="空闲待命" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                        </Border>
                                        <TextBlock x:Name="WorkflowDiagramSubText" Text="等待全入口接单" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#111827" BorderBrush="#24324B" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="WorkflowDiagramRosterSummary" Text="主脑 0 · 执行 0" FontSize="11" Foreground="#94A3B8"/>
                                        </Border>
                                        <Button x:Name="WorkflowDiagramDemoBtn" Content="▶ 演示流转" Style="{StaticResource ActionBtn}" Padding="10,3" FontSize="11.5"
                                                ToolTip="空闲态也可循环演示六阶段流光动画；再点一次停止并回到真实状态"
                                                Click="WorkflowDiagramDemoBtn_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Canvas x:Name="WorkflowDiagramCanvas" Height="158" ClipToBounds="True" SizeChanged="WorkflowDiagramCanvas_SizeChanged"/>
                            </DockPanel>
                        </Border>

                        <!-- 中部双栏：左侧在岗 AI 卡片；右侧最近协同动态 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" MinWidth="360"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="0.85*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左栏：各 AI 实时状态 -->
                            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="在岗 AI 成员" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                        <WrapPanel Grid.Column="1">
                                            <Button Content="云端推荐" Style="{StaticResource ActionBtn}" Padding="8,2" FontSize="11.5" Margin="0,0,6,0" Click="CloudRecTopBtn_Click"/>
                                            <Button Content="配置阵容" Style="{StaticResource ActionBtn}" Padding="8,2" FontSize="11.5" Click="JumpToSettingsBtn_Click"/>
                                        </WrapPanel>
                                    </Grid>
                                    <StackPanel x:Name="OverviewAgentsCards"/>
                                </StackPanel>
                            </Border>

                            <!-- 右栏：最近一次协同派单与工程概况 -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="最近协同回执" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                                        <Border Background="#111722" BorderBrush="#202B3D" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock x:Name="LatestDispatchHeaderText" Text="正在读取最近协同记录..." FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="LatestDispatchMetaText" Text="" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,6" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="LatestDispatchSnippetText" Text="" FontSize="12" Foreground="#94A3B8" LineHeight="18" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        <WrapPanel>
                                            <Button Content="对话与派单" Style="{StaticResource PrimaryBtn}" Padding="10,4" Margin="0,0,6,0" Click="JumpToDialogsBtn_Click"/>
                                            <Button Content="查看全文" Style="{StaticResource ActionBtn}" Padding="10,4" Margin="0,0,6,0" Click="OverviewOpenLatestInboxBtn_Click"/>
                                            <Button x:Name="ClearLiveStatusBtn" Content="清理状态" Style="{StaticResource ActionBtn}" Padding="10,4" ToolTip="清理历史已完成或异常残留的状态记录，归零工作台与悬浮窗面板" Click="ClearLiveStatusBtn_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="当前工程概况" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="OverviewProjectSummaryText" Foreground="#94A3B8" FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <WrapPanel>
                                            <Button x:Name="SyncAnchorsOverviewBtn" Content="同步规则锚点" Style="{StaticResource ActionBtn}" Padding="10,4" Margin="0,0,6,0" Click="SyncAllNowBtn_Click"/>
                                            <Button Content="规则与技能" Style="{StaticResource ActionBtn}" Padding="10,4" Click="JumpToSyncBtn_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== PAGE 2: 项目对话框与聊天记录 ==================== -->
                <Grid x:Name="PageDialogs" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.92*" MinWidth="330" MaxWidth="460"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.08*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左栏：F:\AIChat 项目对话框列表与筛选 -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}" Padding="12,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DialogBrowserCountTitle" Grid.Column="0" Text="◆ 项目对话框列表 (F:\AIChat)" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="RefreshDialogsListBtn" Grid.Column="1" Content="🔄 刷新" Style="{StaticResource ActionBtn}" Padding="8,2" Click="RefreshDialogsListBtn_Click"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DialogAgentFilterCombo" Grid.Column="0" SelectionChanged="DialogFilter_Changed">
                                        <ComboBoxItem Content="● 全部 AI 工具" Tag="all" IsSelected="True"/>
                                        <ComboBoxItem Content="🟣 Antigravity" Tag="antigravity"/>
                                        <ComboBoxItem Content="🟢 Codex / Grok" Tag="codex_cli"/>
                                        <ComboBoxItem Content="🔵 Cursor IDE" Tag="cursor"/>
                                    </ComboBox>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="DialogSearchBox" Padding="9,5,26,5" ToolTip="输入关键词筛选对话标题或 SessionId" TextChanged="DialogSearchBox_TextChanged"/>
                                        <TextBlock x:Name="DialogSearchPlaceholder" Text="🔍 搜索对话标题、AI 或 ID..." Foreground="#64748B" FontSize="11.5"
                                                   Margin="11,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <Button x:Name="ClearDialogSearchBtn" Content="✕" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,0,3,0" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                                Cursor="Hand" FontSize="11" ToolTip="清空搜索" Click="ClearDialogSearchBtn_Click"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DialogCardsStack"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                    <!-- 右栏：对话框聊天内容阅读器 + 底部快捷派单栏 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="12,10" Margin="0,0,0,8">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock x:Name="SelectedDialogTitleText" Text="◆ 请在左侧点选要查看的项目对话框" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SelectedDialogPathText" Text="记录存储位置：F:\AIChat" FontSize="11.5" Foreground="#38BDF8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="ToggleDialogViewModeBtn" Content="📄 原始记录" Style="{StaticResource ActionBtn}" Padding="8,3" Margin="0,0,6,0" ToolTip="在「结构化气泡对话视图」与「原始 Markdown 记录」间切换" Click="ToggleDialogViewModeBtn_Click"/>
                                        <Button x:Name="CopyLatestReplyBtn" Content="📋 复制回复" Style="{StaticResource ActionBtn}" Padding="8,3" Margin="0,0,6,0" ToolTip="一键复制当前对话中最新一条 AI 回复" Click="CopyLatestReplyBtn_Click"/>
                                        <Button x:Name="OpenDialogFileInExplorerBtn" Content="📂 定位文件" Style="{StaticResource ActionBtn}" Padding="8,3" Margin="0,0,6,0" Click="OpenDialogFileInExplorerBtn_Click"/>
                                        <Button x:Name="ShowLatestInboxInReaderBtn" Content="📥 最新反馈" Style="{StaticResource ActionBtn}" Padding="8,3" Click="ShowLatestInboxInReaderBtn_Click"/>
                                    </WrapPanel>
