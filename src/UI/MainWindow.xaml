                <!-- ==================== PAGE 4: 任务单与快照保护 ==================== -->
                <Grid x:Name="PageOps" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.86*" MinWidth="295" MaxWidth="405"/>
