                                                   Foreground="{StaticResource FgMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="PackIncRules" Content="附带项目规范与避坑经验" IsChecked="True" Margin="0,0,0,3"/>
                                        <CheckBox x:Name="PackIncSchema" Content="附带字段速查摘要" IsChecked="True" Margin="0,0,0,3"/>
                                        <CheckBox x:Name="PackIncTaskDiff" Content="附带当前任务单与代码对比" IsChecked="True" Margin="0,0,0,6"/>
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button x:Name="CopyCapsuleBtn" Content="复制脱敏上下文包" Style="{StaticResource AmberBtn}" Margin="0,0,6,2" Click="CopyCapsuleBtn_Click"/>
                                            <Button x:Name="OpenCollabFolderBtn" Content="📂 打开 collab 目录" Style="{StaticResource ActionBtn}" Margin="0,0,0,2" Click="OpenCollabFolderBtn_Click"/>
                                        </WrapPanel>

                                        <Border Height="1" Background="{StaticResource DividerRowBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="手动粘贴外部网页 AI 回复存入 inbox/：" Foreground="{StaticResource FgSecondaryBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                        <TextBox x:Name="InboxPasteBox" Height="46" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,6"/>
