<Window x:Class="AICollabHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AIDeck · 多 AI 协同中心"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="1220" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgCanvasBrush}" Foreground="#E6EDF7"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" Background="{DynamicResource BgCanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 一体式顶部标题与控制栏：支持拖拽移动、双击最大化 + 右上角标准三键 (最小化 / 最大化 / 关闭) -->
        <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="0,0,0,1" Padding="14,0,8,0"
                MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
            <Grid x:Name="HeaderBarGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="HeaderBrandCluster" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderBrandText" Text="AIDeck · 多 AI 协同中心" FontSize="14.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="NoWrap"/>
                    <Button x:Name="HeaderVersionBtn"
                            Style="{StaticResource ActionBtn}"
                            Padding="8,2"
                            Margin="0,0,6,0"
                            FontSize="11.5"
                            ToolTip="AIDeck 当前版本，点击检查更新"
                            Click="HeaderVersionBtn_Click">
                        <TextBlock x:Name="HeaderVersionText" Text="v1.9.14" FontSize="11.5" FontWeight="SemiBold" Foreground="#7DD3FC"/>
                    </Button>
                    <Button x:Name="HeaderUpdateBadgeBtn"
                            Visibility="Collapsed"
                            Style="{StaticResource AmberBtn}"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            FontSize="11.5"
                            Content="发现新版本"
                            ToolTip="检测到新版本，点击下载并重启，或打开发布页"
                            Click="HeaderUpdateBadgeBtn_Click"/>
                    <Border Visibility="Collapsed" Background="#152236" BorderBrush="#263B59" BorderThickness="1" CornerRadius="5" Padding="9,3" VerticalAlignment="Center"
                            ToolTip="所有工程目录、新旧对话框自动按当前总策略执行规则">
                        <TextBlock Text="所有项目与新旧对话通用" FontSize="11.5" Foreground="#7DD3FC"/>
                    </Border>
                </StackPanel>

                <!-- 保留隐藏引用供内部兼容，不在界面展示“选项目”限制 -->
                <ComboBox x:Name="ProjectCombo" Grid.Column="1" Visibility="Collapsed" SelectionChanged="ProjectCombo_SelectionChanged" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0">
                    <Button x:Name="EditProjBtn" Content="路径" Style="{StaticResource ActionBtn}" Padding="9,4" Click="EditProjBtn_Click"/>
                    <Button x:Name="NewProjBtn" Content="＋ 新建" Style="{StaticResource ActionBtn}" Padding="9,4" Margin="5,0,0,0" Click="NewProjBtn_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="WorkflowSwitchBtn"
                            Style="{StaticResource SuccessBtn}"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            AutomationProperties.Name="协同开关"
                            ToolTip="协同已开启，点击关闭"
                            Click="WorkflowSwitchBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="WorkflowSwitchIcon" Width="13" Height="13" Stretch="Uniform"
                                  Fill="#A7F3D0" VerticalAlignment="Center"
                                  Data="M13,2 L4,14 H11 L8,22 L20,9 H12 Z"/>
                            <TextBlock x:Name="WorkflowSwitchLabel" Text="开" Margin="5,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ToggleFloatingBtn"
                            Style="{StaticResource IconToolBtn}"
                            Margin="0,0,6,0"
                            AutomationProperties.Name="悬浮窗"
                            ToolTip="悬浮窗已关闭，点击开启"
                            Click="ToggleFloatingBtn_Click">
                        <Path x:Name="ToggleFloatingIcon" Width="15" Height="15" Stretch="Uniform"
                              Stroke="#C5D2E4" StrokeThickness="1.4" Fill="Transparent"
                              Data="M3,4 H21 V16 H3 Z M12,9 H20 V18 H12 Z"/>
                    </Button>
                    <Button x:Name="CloudRecTopBtn"
                            Content="云端推荐"
                            Visibility="Collapsed"
                            Style="{StaticResource ActionBtn}"
                            Padding="9,4"
                            Margin="0,0,6,0"
                            ToolTip="从云端拉取各 AI 模型最新能力评分并一键应用推荐配置"
                            Click="CloudRecTopBtn_Click"/>
                    <Button x:Name="HeaderOnboardingBtn"
                            Style="{StaticResource IconToolBtn}"
                            Margin="0,0,6,0"
                            AutomationProperties.Name="新手向导"
                            ToolTip="3 步新手向导"
                            Click="HeaderOnboardingBtn_Click">
                        <Path Width="15" Height="15" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Fill="Transparent"
                              Data="M12,3 A9,9 0 1 0 12.01,3 M12,7 L15.5,15 L12,13 L8.5,15 Z"/>
                    </Button>
                    <Button x:Name="TopOpenSettingsBtn"
                            Style="{StaticResource IconToolBtn}"
                            Margin="0,0,10,0"
                            AutomationProperties.Name="设置"
                            ToolTip="打开软件设置"
                            Click="TopOpenSettingsBtn_Click">
                        <Path Width="15" Height="15" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Fill="Transparent"
                              Data="M12,8 A4,4 0 1 0 12.01,8 M12,3 V6 M12,18 V21 M4.5,12 H7.5 M16.5,12 H19.5 M6.4,6.4 L8.4,8.4 M15.6,15.6 L17.6,17.6 M17.6,6.4 L15.6,8.4 M8.4,15.6 L6.4,17.6"/>
                    </Button>

                    <!-- 分隔竖线 + 右上角窗口控制按钮组（最小化 / 最大化 / 关闭） -->
                    <Border Width="1" Height="18" Background="#263348" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Button x:Name="MinimizeToFloatBtn"
                            Content="─"
                            Style="{StaticResource WinCtrlBtn}"
                            ToolTip="最小化到系统托盘（任务栏不占位，桌面可保留悬浮窗）"
                            Click="MinimizeToFloatBtn_Click"/>
                    <Button x:Name="MaximizeRestoreBtn"
                            Content="□"
                            Style="{StaticResource WinCtrlBtn}"
                            ToolTip="最大化 / 还原窗口"
                            Click="MaximizeRestoreBtn_Click"/>
                    <Button x:Name="TopCloseWindowBtn"
                            Content="✕"
                            Style="{StaticResource WinCloseBtn}"
                            ToolTip="关闭主窗口（默认弹窗询问：最小化到托盘 / 退出软件）"
                            Click="TopCloseWindowBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体区：左侧极简导航栏 + 右侧内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="0,0,1,0" Padding="10,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavOverview" Style="{StaticResource NavBtn}" GroupName="MainNav" IsChecked="True" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,3 H10 V10 H3 Z M13,3 H20 V10 H13 Z M3,13 H10 V20 H3 Z M13,13 H20 V20 H13 Z"/>
                                <TextBlock Text="工作台" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavBtn}" GroupName="MainNav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M4,6 H20 M4,12 H20 M4,18 H20 M9,4 V8 M15,10 V14 M8,16 V20"/>
                                <TextBlock Text="AI 配置" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDialogs" Style="{StaticResource NavBtn}" GroupName="MainNav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M4,4 H20 V15 H12 L8,19 V15 H4 Z"/>
                                <TextBlock Text="对话与派单" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAppSettings" Content="设置" Style="{StaticResource NavBtn}" GroupName="MainNav" Checked="Nav_Checked" Visibility="Collapsed"/>
                        <Expander x:Name="NavAdvancedExpander" IsExpanded="False" Margin="0,8,0,0" Focusable="False" Background="Transparent" Foreground="#94A3B8">
                            <Expander.Header>
                                <TextBlock Text="高级" FontSize="12" Foreground="#94A3B8"/>
                            </Expander.Header>
                            <Expander.Template>
                                <ControlTemplate TargetType="Expander">
                                    <StackPanel>
                                        <ToggleButton Cursor="Hand" Focusable="False" Background="Transparent" BorderThickness="0"
                                                      Padding="8,6" HorizontalContentAlignment="Left"
                                                      Content="{TemplateBinding Header}"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="hd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="chev" Text="▸" FontSize="10" Foreground="#64748B" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="chev" Property="Text" Value="▾"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="hd" Property="Background" Value="#1A2333"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Expander.Template>
                            <StackPanel>
                                <RadioButton x:Name="NavSync" Style="{StaticResource NavBtn}" GroupName="MainNav" FontSize="12.5" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.3"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              Data="M5,4 H10 A2,2 0 0 1 12,6 V20 H7 A2,2 0 0 0 5,18 Z M19,4 H14 A2,2 0 0 0 12,6 V20 H17 A2,2 0 0 1 19,18 Z"/>
                                        <TextBlock Text="规则与技能" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavOps" Style="{StaticResource NavBtn}" GroupName="MainNav" FontSize="12.5" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.3"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              Data="M4,8 H8 L10,5 H14 L16,8 H20 V19 H4 Z M12,10 A3,3 0 1 0 12.01,10"/>
                                        <TextBlock Text="快照与任务单" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0">
                            <StackPanel>
                                <TextBlock x:Name="SidebarWorkflowBadge" Text="协同运行" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NetworkHealthBadge" Text="网络在线" Foreground="#94A3B8" FontSize="11.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="McpBadgeText" Text="就绪" Visibility="Collapsed" Foreground="#64748B" FontSize="11"/>
                                <TextBlock x:Name="AiChatRootBadge" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧 6 个功能页容器 -->
            <Grid Grid.Column="1" Margin="18,14,18,14">

                <!-- ==================== PAGE 1: 协同工作台 ==================== -->
                <ScrollViewer x:Name="PageOverview" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 顶部：单行清爽主脑统筹条 -->
                        <Border x:Name="OverviewTopBannerCard" Style="{StaticResource SectionCard}" Padding="16,12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Border x:Name="OverviewModeBadge" Background="#12352C" BorderBrush="#1D6B55" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="OverviewModeBadgeText" Text="运行中" FontSize="12" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                                    </Border>
                                    <TextBlock Text="主脑" FontSize="12.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="OverviewMasterBrainText"
                                               Text="—"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="OverviewRefreshBtn" Visibility="Collapsed" Click="OverviewRefreshBtn_Click"/>
                                    <Button Content="去配置 AI" Style="{StaticResource PrimaryBtn}" Padding="16,8" FontSize="14" Click="JumpToSettingsBtn_Click"
                                            ToolTip="打开 AI 配置，编辑模型与分工"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 断线/中断任务链断点续跑提示横幅（仅在存在未完成断点时自动浮现） -->
                        <Border x:Name="InterruptedCheckpointBanner" Visibility="Collapsed"
                                Style="{StaticResource SectionCard}" Background="#241911" BorderBrush="#9A5B1A" BorderThickness="1" Margin="0,0,0,14" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="CheckpointBannerTitle"
                                               Text="检测到暂停的任务链断点（进度已保护）"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#FDBA74"/>
                                    <TextBlock x:Name="CheckpointBannerDetail"
                                               Text=""
                                               FontSize="11.5" Foreground="#CBD5E1" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="BtnChooseCheckpointResolution" Content="解决" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0" ToolTip="选择解决方式：清理弹窗重试、换通道或改派" Click="BtnChooseCheckpointResolution_Click"/>
                                    <Button x:Name="BtnResumeCheckpoint" Content="断点续跑" Style="{StaticResource AmberBtn}" Margin="0,0,6,0" Click="BtnResumeCheckpoint_Click"/>
                                    <Button x:Name="BtnDismissCheckpoint" Content="忽略" Style="{StaticResource ActionBtn}" Click="BtnDismissCheckpoint_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- 当前工作流动态流程运行图（全宽，位于断点横幅下方、中部双栏上方） -->
                        <Border x:Name="WorkflowDiagramCard" Style="{StaticResource SectionCard}" Padding="14,10" Margin="0,0,0,14">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Ellipse x:Name="WorkflowDiagramStatusDot" Width="9" Height="9" Fill="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="动态工作流" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border x:Name="WorkflowDiagramPhaseBadge" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="WorkflowDiagramPhaseBadgeText" Text="空闲待命" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                        </Border>
                                        <TextBlock x:Name="WorkflowDiagramSubText" Text="等待全入口接单" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#111827" BorderBrush="#24324B" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="WorkflowDiagramRosterSummary" Text="主脑 0 · 执行 0" FontSize="11" Foreground="#94A3B8"/>
                                        </Border>
                                        <Button x:Name="WorkflowDiagramDemoBtn" Style="{StaticResource IconToolBtn}"
                                                AutomationProperties.Name="演示流转"
                                                ToolTip="空闲态也可循环演示六阶段流光动画；再点一次停止并回到真实状态"
                                                Click="WorkflowDiagramDemoBtn_Click">
                                            <Path x:Name="WorkflowDiagramDemoIcon" Width="13" Height="13" Stretch="Uniform"
                                                  Stroke="#E6EDF7" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent"
                                                  Data="M8,5 L18,12 L8,19 Z"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Canvas x:Name="WorkflowDiagramCanvas" Height="158" ClipToBounds="True" SizeChanged="WorkflowDiagramCanvas_SizeChanged"/>
                            </DockPanel>
                        </Border>

                        <!-- 中部双栏：左侧在岗 AI 卡片；右侧最近协同动态 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" MinWidth="360"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="0.85*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左栏：各 AI 实时状态 -->
                            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="在岗 AI 成员" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="OverviewAgentsCards"/>
                                </StackPanel>
                            </Border>

                            <!-- 右栏：最近一次协同派单与工程概况 -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="最近协同回执" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                                        <Border Background="#111722" BorderBrush="#202B3D" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock x:Name="LatestDispatchHeaderText" Text="正在读取最近协同记录..." FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="LatestDispatchMetaText" Text="" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,6" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="LatestDispatchSnippetText" Text="" FontSize="12" Foreground="#94A3B8" LineHeight="18" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                        <WrapPanel>
                                            <Button Content="对话与派单" Style="{StaticResource PrimaryBtn}" Padding="10,4" Margin="0,0,6,0" Click="JumpToDialogsBtn_Click"/>
                                            <Button Content="查看全文" Style="{StaticResource ActionBtn}" Padding="10,4" Margin="0,0,6,0" Click="OverviewOpenLatestInboxBtn_Click"/>
                                            <Button x:Name="ClearLiveStatusBtn" Style="{StaticResource IconToolBtn}"
                                                    AutomationProperties.Name="清理状态"
                                                    ToolTip="清理历史已完成或异常残留的状态记录，归零工作台与悬浮窗面板"
                                                    Click="ClearLiveStatusBtn_Click">
                                                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Data="M5,19 H19 M8,19 L10,7 H14 L16,19 M12,7 V4 M9,4 H15"/>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <Expander IsExpanded="False" Foreground="#E6EDF7" Background="Transparent">
                                        <Expander.Header>
                                            <TextBlock Text="当前工程概况" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        </Expander.Header>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock x:Name="OverviewProjectSummaryText" Foreground="#94A3B8" FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <WrapPanel>
                                                <Button x:Name="SyncAnchorsOverviewBtn" Content="同步规则锚点" Style="{StaticResource ActionBtn}" Padding="10,4" Margin="0,0,6,0" Click="SyncAllNowBtn_Click"/>
                                                <Button Content="规则与技能" Style="{StaticResource ActionBtn}" Padding="10,4" Click="JumpToSyncBtn_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== PAGE 2: 项目对话框与聊天记录 ==================== -->
                <Grid x:Name="PageDialogs" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.92*" MinWidth="330" MaxWidth="460"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.08*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左栏：F:\AIChat 项目对话框列表与筛选 -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}" Padding="12,10">
