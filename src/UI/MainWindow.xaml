                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ExtDetectorsSummary" Grid.Column="0" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                        <WrapPanel Grid.Column="1">
                                            <Button x:Name="OpenRegistryDirBtn" Content="📂 打开配置目录" Style="{StaticResource ActionBtn}" Click="OpenRegistryDirBtn_Click"/>
                                        </WrapPanel>
                                    </Grid>

                                    <!-- 隐藏保留旧高级子控件引用防止事件/方法缺损 -->
                                    <StackPanel Visibility="Collapsed">
                                        <ComboBox x:Name="WorkflowSelectCombo" SelectionChanged="WorkflowSelectCombo_SelectionChanged"/>
                                        <Button x:Name="ImportPresetBtn" Click="ImportPresetBtn_Click"/>
                                        <Button x:Name="ExportPresetBtn" Click="ExportPresetBtn_Click"/>
                                        <TextBlock x:Name="WorkflowDescText"/>
                                        <StackPanel x:Name="StageRoutingList"/>
                                        <WrapPanel x:Name="ExtTagsWrap"/>
                                        <TextBox x:Name="NewTagIdBox"/>
                                        <TextBox x:Name="NewTagNameBox"/>
                                        <TextBox x:Name="NewTagDescBox"/>
                                        <Button x:Name="AddTagBtn" Click="AddTagBtn_Click"/>
                                        <Button x:Name="AddDetectorRuleBtn" Click="AddDetectorRuleBtn_Click"/>
                                        <StackPanel x:Name="ExtHooksList"/>
                                        <ComboBox x:Name="RoleAgentCombo" SelectionChanged="RoleAgentCombo_SelectionChanged"/>
                                        <StackPanel x:Name="AgentCapEditorPanel"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== PAGE 6: 软件与个性化设置（工作流启停总开关 / 仅软件运行时生效 / 开机自启 / 悬浮窗主题） ==================== -->
                <ScrollViewer x:Name="PageAppSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- 软件版本与检查更新 -->
                        <Border Style="{StaticResource SectionCard}" Padding="14,10" Margin="0,0,0,9">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="软件版本与检查更新" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="AIDeck 顶栏版本号可随时检查。启动约 4 秒后会在后台静默检查一次，只有发现新版本才提示。"
                                                   Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCheckAppUpdate"
                                            Grid.Column="1"
                                            Content="立即检查更新"
                                            Style="{StaticResource PrimaryBtn}"
                                            VerticalAlignment="Center"
                                            ToolTip="向已配置的 GitHub / Gitee / 自定义 JSON 更新源检查 AIDeck 新版本"
                                            Click="BtnCheckAppUpdate_Click"/>
                                </Grid>
                                <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9">
                                    <StackPanel>
                                        <TextBlock x:Name="TextAboutCurrentVersion" Text="AIDeck · 多 AI 协同中心 v1.9.14" FontSize="13" FontWeight="SemiBold" Foreground="#E0F2FE" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TextAppUpdateStatus" Text="AIDeck 尚未检查。可手动检查，或等待启动后的后台静默检查。" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="更新源（GitHub / Gitee 仓库、SSH、owner/repo，或自定义 JSON；留空则读取本地 Git origin）" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TextUpdateRepoUrl" Height="28" FontSize="12" Padding="8,4" Margin="0,0,0,8" LostFocus="TextUpdateRepoUrl_LostFocus"
                                                 ToolTip="例如 https://github.com/owner/repo 、git@gitee.com:owner/repo.git 或 https://example.com/latest.json"/>
                                        <CheckBox x:Name="ChkAutoCheckAppUpdate"
                                                  Content="启动后自动检查软件更新（后台执行，不阻塞界面）"
                                                  Foreground="#7DD3FC" FontSize="12"
                                                  Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 1. 工作流全局启停与软件运行生命周期 -->
                        <Border Style="{StaticResource SectionCard}" Padding="14,10" Margin="0,0,0,9">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="一、协同工作流总开关与运行生命周期" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="控制多 AI 协同流程是否启用。停用开关或关闭本软件时，各 AI 自动恢复原生独立状态。"
                                                   Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="BtnCreateDesktopShortcuts" Content="生成桌面图标" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Click="BtnCreateDesktopShortcuts_Click"/>
                                        <Button x:Name="BtnForceQuitApp" Content="彻底退出软件" Style="{StaticResource AmberBtn}" ToolTip="彻底退出本软件（若勾选了仅软件运行时生效，退出时将自动卸载协同锚点）" Click="BtnForceQuitApp_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkWorkflowEngineEnabled"
                                                  Content="启用「多 AI 协同工作流」总开关（取消勾选后立即剥离协同锚点，恢复各自独立对话）"
                                                  Foreground="#F1F5F9" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"
                                                  Checked="WorkflowLifecycleCheckBox_Changed" Unchecked="WorkflowLifecycleCheckBox_Changed"/>

                                        <CheckBox x:Name="ChkWorkflowOnlyWhenRunning"
                                                  Content="仅在本软件运行期间成立（软件退出时自动关闭工作流，下次启动自动恢复）"
                                                  Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,6"
                                                  Checked="WorkflowLifecycleCheckBox_Changed" Unchecked="WorkflowLifecycleCheckBox_Changed"/>

                                        <Border Height="1" Background="{DynamicResource DividerRowBrush}" Margin="0,2,0,6"/>

                                        <CheckBox x:Name="ChkRunAtStartup"
                                                  Content="开机时自动启动「多 AI 协同中心」（写入 Windows 当前用户 Run 启动项）"
                                                  Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,5"
                                                  Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>

                                        <CheckBox x:Name="ChkStartupDirectFloating"
                                                  Content="开机自启时直接进入「桌面悬浮窗 + 系统托盘」静默常驻模式"
                                                  Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"
                                                  Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>

                                        <StackPanel Margin="0,2,0,0">
                                            <TextBlock Text="点击主界面关闭按钮 (×) 时："
                                                       Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="ComboCloseButtonAction"
                                                      Height="28" FontSize="12"
                                                      SelectionChanged="ComboCloseButtonAction_SelectionChanged">
                                                <ComboBoxItem Content="每次弹窗询问（推荐）" Tag="ask"/>
                                                <ComboBoxItem Content="最小化到系统托盘" Tag="minimize_to_tray"/>
                                                <ComboBoxItem Content="直接关闭退出软件" Tag="exit"/>
                                            </ComboBox>
                                            <TextBlock Text="勾选「记住此操作」后可随时在此改回「每次弹窗询问」。"
                                                       Foreground="#64748B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- 隐藏保留旧版复选框引用，与 CloseButtonAction 双向同步 -->
                                        <CheckBox x:Name="ChkCloseToFloating" Visibility="Collapsed"
                                                  Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- 实时核验栏 -->
                                <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="5" Padding="12,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock x:Name="StartupRegStatusTitle" Text="● 开机自启与工作流状态检测中..." FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                            <TextBlock x:Name="StartupRegCommandText" Text="注册表键：HKCU\Software\Microsoft\Windows\CurrentVersion\Run\AICollabHub" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button x:Name="BtnVerifyStartupReg" Grid.Column="1" Content="核验注册表" Style="{StaticResource ActionBtn}" VerticalAlignment="Center" Click="BtnVerifyStartupReg_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 2. 桌面悬浮窗、视觉主题与个性化设置 -->
                        <Border Style="{StaticResource SectionCard}" Padding="14,10" Margin="0,0,0,9">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="二、桌面悬浮窗与外观设置" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="支持主题切换、展开/收起胶囊形态及纵向滑块透明度调节。"
                                                   Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="BtnPreviewExpandFloating" Content="展开悬浮窗" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Click="BtnPreviewExpandFloating_Click"/>
                                        <Button x:Name="BtnPreviewCollapseFloating" Content="收起胶囊" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Click="BtnPreviewCollapseFloating_Click"/>
                                        <Button x:Name="BtnResetFloatingPos" Content="复位右上角" Style="{StaticResource ActionBtn}" Click="BtnResetFloatingPos_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左列：行为与智能联动开关 -->
                                    <Border Grid.Column="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkFloatingEnabled"
                                                      Content="开启桌面悬浮监控窗（常驻桌面实时显示各 AI 小头像与工作动态）"
                                                      Foreground="#F1F5F9" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8"
                                                      Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>

                                            <CheckBox x:Name="ChkFloatingTopmost"
                                                      Content="悬浮窗始终置顶 (Topmost，不被编辑器或游戏窗口遮挡)"
                                                      Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,8"
                                                      Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>

                                            <CheckBox x:Name="ChkFloatingAutoExpand"
                                                      Content="（已锁定停用）任务开始时自动展开 —— 形态仅由用户手动切换，状态变化绝不改形态"
                                                      IsEnabled="False" IsChecked="False"
                                                      Foreground="#64748B" FontSize="12" Margin="0,0,0,8"
                                                      Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>

                                            <CheckBox x:Name="ChkFloatingAutoCollapse"
                                                      Content="（已锁定停用）任务完成后自动收起 —— 原来啥样完成后仍保持啥样"
                                                      IsEnabled="False" IsChecked="False"
                                                      Foreground="#64748B" FontSize="12" Margin="0,0,0,8"
                                                      Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>

                                            <CheckBox x:Name="ChkAutoSyncCloudRec"
                                                      Content="软件启动时自动从云端拉取更新各 AI 推荐能力评分"
                                                      Foreground="#7DD3FC" FontSize="12" Margin="0,0,0,8"
                                                      Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>

                                            <CheckBox x:Name="ChkEnableSoundEffects"
                                                      Content="启用协同提示音效"
                                                      Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,8"
                                                      Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>

                                            <CheckBox x:Name="ChkSoundLightweight"
                                                      Content="音效轻量化（仅保留任务完成提示音）"
                                                      Foreground="#94A3B8" FontSize="12"
                                                      Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="仍听到 Cursor 自带提示音时："
                                                           Foreground="#64748B" FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button x:Name="MuteCursorChimeBtn"
                                                        Content="🔇 关闭 Cursor 内置提示音"
                                                        Style="{StaticResource ActionBtn}"
                                                        Padding="8,3" FontSize="11"
                                                        ToolTip="安全写入 %APPDATA%\Cursor\User\settings.json：关闭对话完成铃声（cursor.composer.shouldChimeAfterChatFinishes / accessibility.signals.chatResponseReceived）。仅合并这两项，不会擅自改动其他键。"
                                                        Click="MuteCursorChimeBtn_Click"/>
                                            </StackPanel>

                                            <!-- 隐藏保留旧版复选框引用 -->
                                            <CheckBox x:Name="ChkFloatingShowWorkflows" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 右列：视觉主题 / 显示形态 / 透明度 / 刷新频率 -->
                                    <Border Grid.Column="2" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.25*" MinWidth="160"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="1*" MinWidth="135"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="全局界面与悬浮窗颜色主题：" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                    <ComboBox x:Name="ComboFloatingTheme" SelectionChanged="ComboFloatingTheme_SelectionChanged">
                                                        <ComboBoxItem Content="🌌 深空暗夜 (默认)" Tag="dark_slate"/>
                                                        <ComboBoxItem Content="⚡ 赛博霓虹 (高对比蓝青)" Tag="cyber_neon"/>
                                                        <ComboBoxItem Content="💎 翡翠微光 (护眼青绿)" Tag="emerald_glass"/>
                                                        <ComboBoxItem Content="👑 黑曜流金 (暖金尊享)" Tag="obsidian_gold"/>
                                                        <ComboBoxItem Content="❄ 极地冰川 (冷冽极光)" Tag="arctic_ocean"/>
                                                        <ComboBoxItem Content="🔥 赤焰碳纤 (竞技暗红)" Tag="crimson_carbon"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="悬浮窗显示形态：" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"/>
                                                    <ComboBox x:Name="ComboFloatingMode" SelectionChanged="ComboFloatingMode_SelectionChanged">
                                                        <ComboBoxItem Content="▾ 展开完整监控面板" Tag="expanded"/>
                                                        <ComboBoxItem Content="▲ 收起为单行头像胶囊" Tag="collapsed"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel x:Name="ThemeSwatchesPanel" Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="悬浮窗透明度 (也可直接在悬浮窗点 ◐ 按钮弹出调节)：" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TextFloatingOpacityPct" Grid.Column="1" Text="95%" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="SliderFloatingOpacity"
                                                        Grid.Column="0"
                                                        Minimum="25" Maximum="100"
                                                        SmallChange="1" LargeChange="5"
                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"
                                                        ValueChanged="SliderFloatingOpacity_ValueChanged"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="50%" Tag="50" Style="{StaticResource ActionBtn}" Padding="5,1" FontSize="10.5" Margin="0,0,3,0" Click="BtnOpacityPreset_Click"/>
                                                    <Button Content="75%" Tag="75" Style="{StaticResource ActionBtn}" Padding="5,1" FontSize="10.5" Margin="0,0,3,0" Click="BtnOpacityPreset_Click"/>
                                                    <Button Content="95%" Tag="95" Style="{StaticResource ActionBtn}" Padding="5,1" FontSize="10.5" Click="BtnOpacityPreset_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="实时状态刷新频率：" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="ComboFloatingRefresh" SelectionChanged="ComboFloatingRefresh_SelectionChanged">
                                                <ComboBoxItem Content="1.0 秒 / 次 · 极速流式刷新" Tag="1000"/>
                                                <ComboBoxItem Content="1.5 秒 / 次 · 标准实时刷新（推荐）" Tag="1500"/>
                                                <ComboBoxItem Content="3.0 秒 / 次 · 低频静默刷新" Tag="3000"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. 网络容灾、断线自动重连与任务链断点续跑设置 -->
                        <Border Style="{StaticResource SectionCard}" Padding="14,10" Margin="0,0,0,9">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="三、后台无感容灾、防卡死自愈与断点保护" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="默认纯后台 CLI / 零焦点投递（不抢鼠标键盘），遇到弹窗卡住或断线支持自动拆弹重试、跨 AI 接力或由您选择解决方式。"
                                                   Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="BtnDismissStuckModalsNow" Content="🧹 清理卡住弹窗" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" ToolTip="在后台静默关闭外部 AI 客户端残留的阻塞模态窗（不抢鼠标键盘）" Click="BtnDismissStuckModalsNow_Click"/>
                                        <Button x:Name="BtnProbeNetworkNow" Content="检测网络" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Click="BtnProbeNetworkNow_Click"/>
                                        <Button x:Name="BtnManualResumeFromSettings" Content="断点续跑" Style="{StaticResource PrimaryBtn}" Click="BtnResumeCheckpoint_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="0.85*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkEnableNetRetry"
                                                      Content="开启断线自动重连与消息未送达重发（指数退避重试）"
                                                      Foreground="#F1F5F9" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8"
                                                      Checked="NetworkResilienceSetting_Changed" Unchecked="NetworkResilienceSetting_Changed"/>

                                            <CheckBox x:Name="ChkWaitLocalNetRecover"
                                                      Content="本机网络掉线时自动挂起等待网络恢复后再重发"
                                                      Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,8"
                                                      Checked="NetworkResilienceSetting_Changed" Unchecked="NetworkResilienceSetting_Changed"/>

                                            <CheckBox x:Name="ChkEnableAgentFailover"
                                                      Content="单个 AI 服务器持续故障时自动切换其他已启用 AI 接力"
                                                      Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,8"
                                                      Checked="NetworkResilienceSetting_Changed" Unchecked="NetworkResilienceSetting_Changed"/>

                                            <CheckBox x:Name="ChkAutoResumeOnNetRecover"
                                                      Content="长时间断网中断后，检测到网络重新连通时自动后台续跑"
                                                      Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"
                                                      Checked="NetworkResilienceSetting_Changed" Unchecked="NetworkResilienceSetting_Changed"/>

                                            <CheckBox x:Name="ChkAutoTrustWorkspaces"
                                                      Content="自动信任已纳管工程目录并免除后台 CLI 交互拦截（自动附加 --trust / -f / --approve-mcps）"
                                                      Foreground="#7DD3FC" FontSize="12"
                                                      Checked="NetworkResilienceSetting_Changed" Unchecked="NetworkResilienceSetting_Changed"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="单轮最大自动重连尝试次数：" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="ComboMaxNetRetries" Margin="0,0,0,8" SelectionChanged="ComboNetworkResilience_SelectionChanged">
                                                <ComboBoxItem Content="2 次 · 快速重试" Tag="2"/>
                                                <ComboBoxItem Content="3 次 · 标准指数退避重连（推荐）" Tag="3"/>
                                                <ComboBoxItem Content="5 次 · 弱网高容错重连" Tag="5"/>
                                                <ComboBoxItem Content="8 次 · 极限抗抖动重试" Tag="8"/>
                                            </ComboBox>

                                            <TextBlock Text="单次执行无响应超时阈值：" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="ComboSingleTimeout" Margin="0,0,0,8" SelectionChanged="ComboNetworkResilience_SelectionChanged">
                                                <ComboBoxItem Content="120 秒 · 快速响应检测" Tag="120"/>
                                                <ComboBoxItem Content="180 秒 · 标准实操超时（推荐）" Tag="180"/>
                                                <ComboBoxItem Content="300 秒 · 复杂大文件重构超时" Tag="300"/>
                                            </ComboBox>

                                            <TextBlock Text="任务卡住 / 外部弹窗阻塞时的处理方式：" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="ComboStallRecoveryPolicy" Margin="0,0,0,8" SelectionChanged="ComboNetworkResilience_SelectionChanged">
                                                <ComboBoxItem Content="先后台自动拆弹重试，仍卡住则让我选择（推荐）" Tag="auto_then_ask"/>
                                                <ComboBoxItem Content="一旦卡住立即提醒并由我选择解决方式" Tag="ask_user_immediately"/>
                                                <ComboBoxItem Content="全自动静默自愈（重试 ➔ 换 AI ➔ 交回主脑）" Tag="auto_self_heal"/>
                                            </ComboBox>

                                            <TextBlock x:Name="TextNetDiagStatus"
                                                       Text="● 网络实时诊断：本机外网连通正常 · 自动容灾保护已就绪"
                                                       FontSize="11.5" Foreground="#34D399" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. 默认折叠的目录管理与便携分享说明 -->
                        <Border Style="{StaticResource SectionCard}">
                            <Expander IsExpanded="False" Foreground="#E6EDF7">
                                <Expander.Header>
                                    <TextBlock Text="📂 展开查看本机数据目录与绿色便携包分享说明" FontSize="13" FontWeight="SemiBold" Foreground="#9AA8BE" Margin="4,0,0,0"/>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="• 独立绿色分享：点击顶部「📤 分享软件 (.zip)」即可生成不含任何个人路径或聊天记录的纯净压缩包，发给他人解压双击即可在对方电脑上自动扫描配置。&#x0a;• 三处同步常驻：本软件在主界面、桌面置顶悬浮窗、任务栏与右下角系统托盘图标三处同步显示，右键点击托盘图标可随时启停工作流或彻底退出。"
                                               Foreground="#A5B4CB" FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Content="📂 打开个人配置目录 (%LOCALAPPDATA%\AICollabHub)" Style="{StaticResource ActionBtn}" Margin="0,0,8,0" Click="BtnOpenUserDataDir_Click"/>
                                        <Button Content="📂 打开 F:\AIChat 跨工具聊天记录库" Style="{StaticResource ActionBtn}" Margin="0,0,8,0" Click="BtnOpenAiChatDir_Click"/>
                                        <Button x:Name="ExportShareZipBtn" Content="📤 一键导出便携分享包 (.zip)" Style="{StaticResource AmberBtn}" Click="ExportShareZipBtn_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="就绪 · 多 AI 协同工作流运行中" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                <TextBlock x:Name="RightDataPathText" Grid.Column="1" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
