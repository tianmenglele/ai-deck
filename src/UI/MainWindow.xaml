                                    </StackPanel>
                                </Grid>

                                <!-- 视图 A：按 AI 角色与能力总览（右侧胶囊开关启停工作流） -->
                                <StackPanel x:Name="PanelViewByAgent">
                                    <WrapPanel x:Name="RosterFilterBar" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="DetectedAgentsList"/>
                                </StackPanel>

                                <!-- 视图 B：按工作内容路由总览（纯只读） -->
                                <StackPanel x:Name="PanelViewByWorkRoute" Visibility="Collapsed">
