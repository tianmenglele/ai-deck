                                                    Margin="10,0,26,0" IsHitTestVisible="False">
                                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="#64748B" StrokeThickness="1.5"
                                                  Data="M10,4 A5,5 0 1 0 10,14 A5,5 0 1 0 10,4 M14,14 L18,18" VerticalAlignment="Center"/>
                                            <TextBlock Text="搜索" Foreground="#64748B" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button x:Name="ClearDialogSearchBtn" Content="✕" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,0,3,0" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                                Cursor="Hand" FontSize="11" ToolTip="清空搜索" Click="ClearDialogSearchBtn_Click"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DialogCardsStack"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                    <!-- 右栏：对话框聊天内容阅读器 + 底部快捷派单栏 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="12,10" Margin="0,0,0,8">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock x:Name="SelectedDialogTitleText" Text="点左侧对话" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="SelectedDialogPathText" Visibility="Collapsed" Text="" FontSize="11.5" Foreground="#38BDF8"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="ToggleDialogViewModeBtn" Content="📄 原始记录" Style="{StaticResource ActionBtn}" Padding="8,3" Margin="0,0,6,0" ToolTip="在「结构化气泡对话视图」与「原始 Markdown 记录」间切换" Click="ToggleDialogViewModeBtn_Click"/>
                                        <Button x:Name="CopyLatestReplyBtn" Content="📋 复制回复" Style="{StaticResource ActionBtn}" Padding="8,3" Margin="0,0,6,0" ToolTip="一键复制当前对话中最新一条 AI 回复" Click="CopyLatestReplyBtn_Click"/>
                                        <Button x:Name="OpenDialogFileInExplorerBtn" Content="📂 定位文件" Style="{StaticResource ActionBtn}" Padding="8,3" Margin="0,0,6,0" Click="OpenDialogFileInExplorerBtn_Click"/>
                                        <Button x:Name="ShowLatestInboxInReaderBtn" Content="📥 最新反馈" Style="{StaticResource ActionBtn}" Padding="8,3" Click="ShowLatestInboxInReaderBtn_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <Grid>
                                    <ScrollViewer x:Name="DialogStructuredScroll" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="DialogBubblesPanel" Margin="0,2,4,2"/>
                                    </ScrollViewer>
                                    <TextBox x:Name="DialogTranscriptReaderBox" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12.5"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- 下部：向外部 AI 分配工作 -->
                        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Background="#151F2E" BorderBrush="#2C4866" Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="分配任务"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#7DD3FC" Margin="0,0,0,6"
                                           ToolTip="由主脑按能力挑选 AI，或手动指定 AI 直接改工程"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1*" MinWidth="130"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1.2*" MinWidth="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="执行 AI：" Foreground="{StaticResource FgSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="HeadlessTargetCombo" Grid.Column="1" SelectionChanged="HeadlessTargetCombo_SelectionChanged"/>
                                    <TextBlock Grid.Column="3" Text="对话框：" Foreground="{StaticResource FgSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="TargetDialogCombo" Grid.Column="4"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="QuickDispatchPromptBox" Grid.Column="0"
                                             Text="请结合当前项目规则与 TASK.md，检查最近改动的潜在风险并给出 3 条精简建议。"/>
                                    <Button x:Name="RunHeadlessDispatchBtn" Grid.Column="2" Content="派单执行" Style="{StaticResource SuccessBtn}" ToolTip="分配任务并执行" Click="RunHeadlessDispatchBtn_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================== PAGE 3: 规则与技能同步 ==================== -->
                <Grid x:Name="PageSync" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,8" Padding="12,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="协同开启时自动挂载规则与技能" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="开启工作流时自动挂载共享技能与规则锚点，停用或退出时自动剥离并恢复原样"/>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button x:Name="InitFoundationBtn" Content="初始化工程目录" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Click="InitFoundationBtn_Click"/>
                                    <Button x:Name="RestoreSyncBackupBtn" Content="恢复上次备份" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Click="RestoreSyncBackupBtn_Click"/>
                                    <Button x:Name="SyncAllNowBtn" Content="立即同步" Style="{StaticResource SuccessBtn}" ToolTip="立即挂载同步规则与技能" Click="SyncAllNowBtn_Click"/>
                                </WrapPanel>
                            </Grid>
                            <Border Height="1" Background="{StaticResource DividerRowBrush}" Margin="0,6,0,5"/>
                            <TextBlock x:Name="SsotPathsSummary" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,8" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="◆ 各已启用 AI 工具的规则与技能生效状态" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel x:Name="SyncHealthList"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.12*" MinWidth="360"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="0.88*" MinWidth="290"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SectionCard}" Padding="12,8">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RuleSkillListTitle" Grid.Column="0" Text="◆ 技能与规则明细" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="RuleSkillFilterCombo" Grid.Column="1" Width="142" SelectionChanged="RuleSkillFilterCombo_SelectionChanged">
                                        <ComboBoxItem Content="全部" Tag="all" IsSelected="True"/>
                                        <ComboBoxItem Content="技能" Tag="skill"/>
                                        <ComboBoxItem Content="项目规则" Tag="rule"/>
                                        <ComboBoxItem Content="全局规则" Tag="global"/>
                                    </ComboBox>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="RuleSkillInventoryPanel"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                        <Border Grid.Column="2" Style="{StaticResource SectionCard}" Padding="12,8">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RuleSkillPreviewTitle" Grid.Column="0" Text="◆ 规则 / 技能全文与应用详情" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <Button x:Name="OpenRuleSkillFileBtn" Grid.Column="1" Content="📂 打开源文件" Style="{StaticResource ActionBtn}" Padding="8,2" Click="OpenRuleSkillFileBtn_Click"/>
                                </Grid>
                                <TextBox x:Name="RuleSkillPreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================== PAGE 4: 任务单与快照保护 ==================== -->
                <Grid x:Name="PageOps" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.86*" MinWidth="295" MaxWidth="405"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.14*" MinWidth="350"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8" Padding="12,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="快照与改动对比" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   ToolTip="为当前工程建立基准快照，查看最近代码改动，或一键回滚。"/>
                                        <TextBlock x:Name="VcsModeBadge" Grid.Column="1" Foreground="#38BDF8" FontSize="11.5" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="EditorConflictText" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button x:Name="CreateSnapBtn" Content="新建基准快照" Style="{StaticResource ActionBtn}" Margin="0,0,6,4" Click="CreateSnapBtn_Click"/>
                                        <Button x:Name="GenDiffBtn" Content="查看最近代码改动 (Diff)" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,4" Click="GenDiffBtn_Click"/>
                                        <Button x:Name="RollbackSnapBtn" Content="一键回滚至基准" Style="{StaticResource ActionBtn}" Margin="0,0,0,4" Click="RollbackSnapBtn_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}" Padding="12,10">
                                <Expander IsExpanded="False" Foreground="#E6EDF7">
                                    <Expander.Header>
                                        <TextBlock Text="📦 跨机器离线脱敏包与手动粘贴回收（备用）" FontSize="12.5" FontWeight="SemiBold" Foreground="#9AA8BE"/>
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="仅在发给外部网页 AI 时使用"
                                                   Foreground="{StaticResource FgMutedBrush}" FontSize="12" Margin="0,0,0,6"
                                                   ToolTip="本机 AI 已自动直连。只有要把项目发给外部网页 AI 时，才需要脱敏包或手动粘贴回收。"/>
                                        <CheckBox x:Name="PackIncRules" Content="附带项目规范与避坑经验" IsChecked="True" Margin="0,0,0,3"/>
                                        <CheckBox x:Name="PackIncSchema" Content="附带字段速查摘要" IsChecked="True" Margin="0,0,0,3"/>
                                        <CheckBox x:Name="PackIncTaskDiff" Content="附带当前任务单与代码对比" IsChecked="True" Margin="0,0,0,6"/>
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button x:Name="CopyCapsuleBtn" Content="复制脱敏上下文包" Style="{StaticResource AmberBtn}" Margin="0,0,6,2" Click="CopyCapsuleBtn_Click"/>
                                            <Button x:Name="OpenCollabFolderBtn" Content="📂 打开 collab 目录" Style="{StaticResource ActionBtn}" Margin="0,0,0,2" Click="OpenCollabFolderBtn_Click"/>
                                        </WrapPanel>

                                        <Border Height="1" Background="{StaticResource DividerRowBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="手动粘贴外部网页 AI 回复存入 inbox/：" Foreground="{StaticResource FgSecondaryBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                        <TextBox x:Name="InboxPasteBox" Height="46" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,6"/>
                                        <Button x:Name="SaveToInboxBtn" Content="存入 work/collab/inbox/" Style="{StaticResource ActionBtn}" HorizontalAlignment="Left" Click="SaveToInboxBtn_Click"/>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                    <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RightEditorTitle" Grid.Column="0" Text="◆ 当前项目协同任务单 (work/collab/TASK.md)" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BackToTaskCardBtn" Content="⬅ 返回任务单" Style="{StaticResource AmberBtn}" Margin="0,0,6,0" Visibility="Collapsed" Click="BackToTaskCardBtn_Click"/>
                                    <Button x:Name="ReloadTaskBtn" Content="刷新读取" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Click="ReloadTaskBtn_Click"/>
                                    <Button x:Name="SaveTaskBtn" Content="保存任务单" Style="{StaticResource PrimaryBtn}" Click="SaveTaskBtn_Click"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <TextBlock Text="归档时可记一条经验"
                                           Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,4"
                                           ToolTip="任务完成后归档，可顺手记 1 条本轮踩坑经验，自动写入全员共读经验库"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewPitfallBox" Grid.Column="0"/>
                                    <Button x:Name="ArchiveTaskBtn" Grid.Column="1" Content="✓ 归档本轮任务" Style="{StaticResource SuccessBtn}" Margin="8,0,0,0" Click="ArchiveTaskBtn_Click"/>
                                </Grid>
                            </StackPanel>

                            <TextBox x:Name="TaskEditorBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12.5"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ==================== PAGE 5: AI 阵容与路由（合并双视图：按 AI 工具管理 / 按工作内容路由） ==================== -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- 1. 顶部配置方案总览栏（极简无套娃设计） -->
                        <Border Style="{StaticResource SectionCard}" Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- 第 1 行：配置方案选择 + 切换启用 + 配置方案入口 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MaxWidth="280"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="配置方案" Foreground="#94A3B8" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="TeamProfileCombo" Grid.Column="1" SelectionChanged="TeamProfileCombo_SelectionChanged"
                                              ToolTip="选择要预览的团队配置方案，点「切换启用」正式生效"/>
                                    <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                                        <Button x:Name="BtnApplyTeamProfile" Content="当前使用中" Style="{StaticResource ActionBtn}" Padding="10,6" FontSize="12" Margin="0,0,8,0" IsEnabled="False"
                                                ToolTip="将左侧选中的配置方案正式切换启用" Click="BtnApplyTeamProfile_Click"/>
                                        <Button x:Name="BtnManageTeamProfiles" Content="编辑模型与分工" Style="{StaticResource PrimaryBtn}" Padding="16,8" FontSize="14" Margin="0,0,8,0"
                                                ToolTip="打开配置方案中心：调整 AI 模型、能力强度、规则与路由"
                                                Click="BtnManageTeamProfiles_Click"/>
                                        <Button x:Name="RescanBtn" Style="{StaticResource ActionBtn}" Padding="8,4" Margin="0,0,6,0" ToolTip="重新扫描本机已安装的 AI 客户端、扩展与 CLI" Click="RescanBtn_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#E6EDF7" StrokeThickness="1.5" VerticalAlignment="Center"
                                                      Data="M16,5 V9 H12 M16,9 A6,6 0 1 1 14,5.2"/>
                                                <TextBlock Text="扫描" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource AmberBtn}" Padding="8,4" ToolTip="从云端拉取各 AI 模型最新能力评分并应用推荐" Click="CloudRecTopBtn_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#FDE68A" StrokeThickness="1.4" VerticalAlignment="Center"
                                                      Data="M12,3 L13.6,9 H20 L14.8,12.6 L16.6,19 L12,15.2 L7.4,19 L9.2,12.6 L4,9 H10.4 Z"/>
                                                <TextBlock Text="推荐" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Grid>

                                <!-- 第 2 行：无边框分割线 + 素雅单行方案摘要 -->
                                <Border x:Name="SettingsSaveBar" Background="Transparent" BorderBrush="{DynamicResource DividerRowBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel x:Name="ActiveProfileSummaryBar" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="SettingsSaveHintText" Grid.Column="1"
                                                   Text=""
                                                   FontSize="11" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <!-- 隐藏保留既有内部字段引用（所有修改均收敛至「⚙ 配置方案」） -->
                                <StackPanel Visibility="Collapsed">
                                    <ComboBox x:Name="MasterPlannerCombo" SelectionChanged="MasterPlannerCombo_SelectionChanged"/>
                                    <ComboBox x:Name="FallbackAgentCombo" SelectionChanged="FallbackAgentCombo_SelectionChanged"/>
                                    <Button x:Name="OpenCloudRecDialogBtn" Click="CloudRecTopBtn_Click"/>
                                    <Button x:Name="ApplyAllRecommendedBtn" Click="ApplyAllRecommendedBtn_Click"/>
                                    <Button x:Name="BtnDiscardRosterSettings" Click="BtnDiscardRosterSettings_Click"/>
                                    <Button x:Name="BtnSaveRosterSettings" Click="BtnSaveRosterSettings_Click"/>
                                    <TextBlock x:Name="CloudRecStatusSummaryText"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. 主卡片：当前方案 AI 角色·功能只读总览 & 工作路由总览 + 右侧非配置运维操作 -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 双视角分段切换胶囊 -->
                                    <Border Grid.Column="0" Background="#0F1520" BorderBrush="#222D40" BorderThickness="1" CornerRadius="6" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioViewByAgent" Content="按 AI 角色与能力总览" IsChecked="True"
                                                         GroupName="RosterRouteSwitch" Checked="RosterRouteView_Changed"
                                                         Foreground="#F8FAFC" FontSize="12.5" Cursor="Hand" Padding="12,4">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#1F324D"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>
                                            <RadioButton x:Name="RadioViewByWorkRoute" Content="按工作内容路由总览"
                                                         GroupName="RosterRouteSwitch" Checked="RosterRouteView_Changed"
                                                         Foreground="#F8FAFC" FontSize="12.5" Cursor="Hand" Padding="12,4">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#1F324D"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="ScanSummaryTitle" Text="已启用 3 项工具" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel x:Name="AgentViewToolbar" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="WorkflowSwitchManagerBtn" Content="工作流开关" Style="{StaticResource PrimaryBtn}" Padding="9,4" Margin="0,0,6,0" ToolTip="集中批量启停各 AI 工具是否参与工作流" Click="WorkflowSwitchManagerBtn_Click"/>
                                        <Button x:Name="AddCustomAiBtn" Style="{StaticResource ActionBtn}" Padding="8,4" ToolTip="接入并纳管额外的外部 AI 工具节点" Click="AddCustomAiBtn_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Stretch="Uniform" Stroke="#E6EDF7" StrokeThickness="1.6" VerticalAlignment="Center"
                                                      Data="M12,4 V20 M4,12 H20"/>
                                                <TextBlock Text="AI" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- 视图 A：按 AI 角色与能力总览（右侧胶囊开关启停工作流） -->
                                <StackPanel x:Name="PanelViewByAgent">
                                    <WrapPanel x:Name="RosterFilterBar" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="DetectedAgentsList"/>
                                </StackPanel>

                                <!-- 视图 B：按工作内容路由总览（纯只读） -->
                                <StackPanel x:Name="PanelViewByWorkRoute" Visibility="Collapsed">
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="⚙ 在配置方案中调整路由" Style="{StaticResource PrimaryBtn}" Padding="10,3" FontSize="11.5" Click="BtnManageTeamProfiles_Click"/>
                                        <TextBlock Text="12 类工作的分工，悬停看详情"
                                                   Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   ToolTip="当前方案下 12 类工作内容的只读路由。右侧是已启用且具备能力的 AI。要改分工，点「编辑模型与分工」。"/>
                                    </DockPanel>
                                    <WrapPanel x:Name="RouteOverviewLegendPanel" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="MagpieWorkRoutesPanel"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. 环境扩展信息（仅保留目录打开与只读未安装说明，严禁放任何未安装工具的 CLI 安装诱导按钮） -->
                        <Border Style="{StaticResource SectionCard}" Padding="14,10">
                            <Expander IsExpanded="False" Foreground="#E6EDF7">
                                <Expander.Header>
                                    <TextBlock Text="环境说明（未安装受支持工具状态 / 规则配置目录）"
                                               FontSize="12.5" Foreground="#94A3B8" Margin="4,0,0,0"/>
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="本机未检测到安装的其他受支持工具（仅说明兼容能力，未安装不弹窗也不提示安装 CLI）：" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <WrapPanel x:Name="UndetectedAgentsWrap" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ExtDetectorsSummary" Grid.Column="0" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>

                                    <!-- 隐藏保留旧高级子控件引用防止事件/方法缺损 -->
                                    <StackPanel Visibility="Collapsed">
                                        <ComboBox x:Name="WorkflowSelectCombo" SelectionChanged="WorkflowSelectCombo_SelectionChanged"/>
                                        <Button x:Name="ImportPresetBtn" Click="ImportPresetBtn_Click"/>
                                        <Button x:Name="ExportPresetBtn" Click="ExportPresetBtn_Click"/>
                                        <TextBlock x:Name="WorkflowDescText"/>
                                        <StackPanel x:Name="StageRoutingList"/>
                                        <WrapPanel x:Name="ExtTagsWrap"/>
                                        <TextBox x:Name="NewTagIdBox"/>
                                        <TextBox x:Name="NewTagNameBox"/>
                                        <TextBox x:Name="NewTagDescBox"/>
                                        <Button x:Name="AddTagBtn" Click="AddTagBtn_Click"/>
                                        <Button x:Name="AddDetectorRuleBtn" Click="AddDetectorRuleBtn_Click"/>
                                        <StackPanel x:Name="ExtHooksList"/>
                                        <ComboBox x:Name="RoleAgentCombo" SelectionChanged="RoleAgentCombo_SelectionChanged"/>
                                        <StackPanel x:Name="AgentCapEditorPanel"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== PAGE 6: 设置二级页（常规 / 外观 / 容灾 / 关于） ==================== -->
                <DockPanel x:Name="PageAppSettings" Visibility="Collapsed" LastChildFill="True">
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnSettingsBack" Style="{StaticResource ActionBtn}" Padding="8,4" Margin="0,0,12,0"
                                        ToolTip="返回上一页" Click="BtnSettingsBack_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="#E6EDF7" StrokeThickness="1.6"
                                              Data="M14,5 L7,12 L14,19 M7,12 H20" VerticalAlignment="Center"/>
                                        <TextBlock Text="返回" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#121924" BorderBrush="#232D3F" BorderThickness="1" CornerRadius="8" Padding="3,2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TabSettingsGeneral" GroupName="SettingsSubTabs" Tag="general" IsChecked="True"
                                                 Style="{StaticResource SettingsSegTabBtn}" Checked="SettingsSubTab_Checked"
                                                 ToolTip="协同开关、开机与关闭行为">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.4"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  Data="M12,8 A4,4 0 1 0 12.01,8 M12,3 V6 M12,18 V21 M5,12 H8 M16,12 H19 M7,7 L9,9 M15,15 L17,17 M17,7 L15,9 M9,15 L7,17"/>
                                            <TextBlock Text="常规" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TabSettingsAppearance" GroupName="SettingsSubTabs" Tag="appearance"
                                                 Style="{StaticResource SettingsSegTabBtn}" Checked="SettingsSubTab_Checked"
                                                 ToolTip="主题、形态与透明度">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.4"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  Data="M3,4 H21 V16 H3 Z M3,8 H21 M6,12 H8 M11,12 H13 M16,12 H18"/>
                                            <TextBlock Text="外观" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TabSettingsResilience" GroupName="SettingsSubTabs" Tag="resilience"
                                                 Style="{StaticResource SettingsSegTabBtn}" Checked="SettingsSubTab_Checked"
                                                 ToolTip="断线可重试或换人">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.4"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  Data="M12,3 L19,6 V12 C19,16 16,19 12,21 C8,19 5,16 5,12 V6 Z M8,13 H10.5 L12,9 L13.5,15 L15,12 H17"/>
                                            <TextBlock Text="容灾" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TabSettingsAbout" GroupName="SettingsSubTabs" Tag="about"
                                                 Style="{StaticResource SettingsSegTabBtn}" Checked="SettingsSubTab_Checked"
                                                 ToolTip="版本、更新与新手引导">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.4"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  Data="M12,3 A8,8 0 1 0 12.01,3 M12,10 V16 M12,7.2 V7.6"/>
                                            <TextBlock Text="关于" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <StackPanel x:Name="SettingsPanelGeneral">
                                <Border Style="{StaticResource SectionCard}" Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="协同与运行" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"
                                                       ToolTip="控制多 AI 协同是否启用。停用或关闭本软件时，各 AI 自动恢复独立状态。"/>
                                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button x:Name="BtnCreateDesktopShortcuts" Style="{StaticResource IconToolBtn}" Margin="0,0,6,0"
                                                        AutomationProperties.Name="桌面图标" ToolTip="生成桌面图标" Click="BtnCreateDesktopShortcuts_Click">
                                                    <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.4"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M4,4 H20 V14 H4 Z M8,18 H16 M12,14 V18"/>
                                                </Button>
                                                <Button x:Name="BtnForceQuitApp" Style="{StaticResource AmberBtn}" Padding="8,4"
                                                        ToolTip="彻底退出本软件（若勾选了仅软件运行时生效，退出时将自动卸载协同锚点）"
                                                        Click="BtnForceQuitApp_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="13" Height="13" Stretch="Uniform" Stroke="#FDE68A" StrokeThickness="1.6" VerticalAlignment="Center"
                                                              Data="M12,3 V10 M7.2,6.2 A6,6 0 1 0 16.8,6.2"/>
                                                        <TextBlock Text="退出" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </Grid>
                                        <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <CheckBox x:Name="ChkWorkflowEngineEnabled"
                                                          Content="启用协同工作流"
                                                          ToolTip="启用多 AI 协同总开关。取消勾选后立即剥离协同锚点，恢复各自独立对话。"
                                                          Foreground="#F1F5F9" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8"
                                                          Checked="WorkflowLifecycleCheckBox_Changed" Unchecked="WorkflowLifecycleCheckBox_Changed"/>
                                                <CheckBox x:Name="ChkWorkflowOnlyWhenRunning"
                                                          Content="仅软件运行时生效"
                                                          ToolTip="软件退出时自动关闭工作流，下次启动自动恢复。停用即各自独立。"
                                                          Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,8"
                                                          Checked="WorkflowLifecycleCheckBox_Changed" Unchecked="WorkflowLifecycleCheckBox_Changed"/>
                                                <Border Height="1" Background="{DynamicResource DividerRowBrush}" Margin="0,2,0,8"/>
                                                <CheckBox x:Name="ChkRunAtStartup"
                                                          Content="开机自动启动"
                                                          ToolTip="写入 Windows 当前用户 Run 启动项，登录后自动启动 AIDeck。"
                                                          Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,8"
                                                          Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                                <CheckBox x:Name="ChkStartupDirectFloating"
                                                          Content="开机进悬浮窗"
                                                          ToolTip="开机自启时直接进入桌面悬浮窗和系统托盘，不打开主窗口。"
                                                          Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"
                                                          Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                                <TextBlock Text="关闭按钮" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"
                                                           ToolTip="点击主界面关闭按钮时的行为。可改回每次询问。"/>
                                                <ComboBox x:Name="ComboCloseButtonAction"
                                                          Height="28" FontSize="12"
                                                          ToolTip="可改回每次询问。勾选记住此操作后，可随时在此改回每次弹窗询问。"
                                                          SelectionChanged="ComboCloseButtonAction_SelectionChanged">
                                                    <ComboBoxItem Content="每次询问" Tag="ask"/>
                                                    <ComboBoxItem Content="最小化到托盘" Tag="minimize_to_tray"/>
                                                    <ComboBoxItem Content="直接退出" Tag="exit"/>
                                                </ComboBox>
                                                <CheckBox x:Name="ChkCloseToFloating" Visibility="Collapsed"
                                                          Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="SettingsPanelAppearance" Visibility="Collapsed">
                                <Border Style="{StaticResource SectionCard}" Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="悬浮窗与外观" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"
                                                       ToolTip="主题、形态、透明度。支持展开、收起胶囊，以及复位位置。"/>
                                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button x:Name="BtnPreviewExpandFloating" Style="{StaticResource IconToolBtn}" Margin="0,0,6,0"
                                                        AutomationProperties.Name="展开悬浮窗" ToolTip="展开悬浮窗" Click="BtnPreviewExpandFloating_Click">
                                                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M9,3 H3 V9 M15,3 H21 V9 M21,15 V21 H15 M3,15 V21 H9"/>
                                                </Button>
                                                <Button x:Name="BtnPreviewCollapseFloating" Style="{StaticResource IconToolBtn}" Margin="0,0,6,0"
                                                        AutomationProperties.Name="收起胶囊" ToolTip="收起胶囊" Click="BtnPreviewCollapseFloating_Click">
                                                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M3,9 H9 V3 M15,3 V9 H21 M21,15 H15 V21 M9,21 V15 H3"/>
                                                </Button>
                                                <Button x:Name="BtnResetFloatingPos" Style="{StaticResource IconToolBtn}"
                                                        AutomationProperties.Name="复位右上角" ToolTip="复位右上角" Click="BtnResetFloatingPos_Click">
                                                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M4,12 A8,8 0 1 0 6,6.5 M4,4 V9 H9"/>
                                                </Button>
                                            </WrapPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel>
                                                    <CheckBox x:Name="ChkFloatingEnabled"
                                                              Content="开启桌面悬浮窗"
                                                              ToolTip="常驻桌面，实时显示各 AI 头像与工作动态。"
                                                              Foreground="#F1F5F9" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8"
                                                              Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                                    <CheckBox x:Name="ChkFloatingTopmost"
                                                              Content="悬浮窗始终置顶"
                                                              ToolTip="不被编辑器或游戏窗口遮挡。"
                                                              Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,8"
                                                              Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                                    <CheckBox x:Name="ChkAutoSyncCloudRec"
                                                              Content="启动同步云端评分"
                                                              ToolTip="软件启动时自动从云端拉取并更新各 AI 推荐能力评分。"
                                                              Foreground="#7DD3FC" FontSize="12" Margin="0,0,0,8"
                                                              Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                                    <CheckBox x:Name="ChkEnableSoundEffects"
                                                              Content="启用协同提示音效"
                                                              ToolTip="任务派发、完成时播放轻提示音。"
                                                              Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,8"
                                                              Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                                    <CheckBox x:Name="ChkSoundLightweight"
                                                              Content="只留完成提示音"
                                                              ToolTip="音效轻量化，仅保留任务完成提示音。"
                                                              Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"
                                                              Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                                    <Button x:Name="MuteCursorChimeBtn" Style="{StaticResource IconToolBtn}" HorizontalAlignment="Left"
                                                            AutomationProperties.Name="静音"
                                                            ToolTip="关掉 Cursor 内置提示音。安全写入 %APPDATA%\Cursor\User\settings.json：关闭对话完成铃声。仅合并这两项，不会改动其他键。"
                                                            Click="MuteCursorChimeBtn_Click">
                                                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.4"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              Data="M4,9 H7 L12,5 V19 L7,15 H4 Z M16,9 L20,15 M20,9 L16,15"/>
                                                    </Button>
                                                    <CheckBox x:Name="ChkFloatingShowWorkflows" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.25*" MinWidth="140"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="1*" MinWidth="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="主题" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"
                                                                       ToolTip="全局界面与悬浮窗颜色主题"/>
                                                            <ComboBox x:Name="ComboFloatingTheme" SelectionChanged="ComboFloatingTheme_SelectionChanged">
                                                                <ComboBoxItem Content="深空暗夜" Tag="dark_slate"/>
                                                                <ComboBoxItem Content="赛博霓虹" Tag="cyber_neon"/>
                                                                <ComboBoxItem Content="翡翠微光" Tag="emerald_glass"/>
                                                                <ComboBoxItem Content="黑曜流金" Tag="obsidian_gold"/>
                                                                <ComboBoxItem Content="极地冰川" Tag="arctic_ocean"/>
                                                                <ComboBoxItem Content="赤焰碳纤" Tag="crimson_carbon"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="形态" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"
                                                                       ToolTip="悬浮窗显示形态"/>
                                                            <ComboBox x:Name="ComboFloatingMode" SelectionChanged="ComboFloatingMode_SelectionChanged">
                                                                <ComboBoxItem Content="展开面板" Tag="expanded"/>
                                                                <ComboBoxItem Content="收起胶囊" Tag="collapsed"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>
                                                    <WrapPanel x:Name="ThemeSwatchesPanel" Margin="0,0,0,8"/>
                                                    <Grid Margin="0,0,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="透明度" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" VerticalAlignment="Center"
                                                                   ToolTip="悬浮窗透明度。也可直接在悬浮窗点调节。"/>
                                                        <TextBlock x:Name="TextFloatingOpacityPct" Grid.Column="1" Text="95%" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider x:Name="SliderFloatingOpacity"
                                                                Grid.Column="0"
                                                                Minimum="25" Maximum="100"
                                                                SmallChange="1" LargeChange="5"
                                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"
                                                                ValueChanged="SliderFloatingOpacity_ValueChanged"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="50%" Tag="50" Style="{StaticResource ActionBtn}" Padding="5,1" FontSize="10.5" Margin="0,0,3,0" Click="BtnOpacityPreset_Click"/>
                                                            <Button Content="75%" Tag="75" Style="{StaticResource ActionBtn}" Padding="5,1" FontSize="10.5" Margin="0,0,3,0" Click="BtnOpacityPreset_Click"/>
                                                            <Button Content="95%" Tag="95" Style="{StaticResource ActionBtn}" Padding="5,1" FontSize="10.5" Click="BtnOpacityPreset_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="刷新" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"
                                                               ToolTip="实时状态刷新频率"/>
                                                    <ComboBox x:Name="ComboFloatingRefresh" SelectionChanged="ComboFloatingRefresh_SelectionChanged">
                                                        <ComboBoxItem Content="1 秒" Tag="1000"/>
                                                        <ComboBoxItem Content="1.5 秒" Tag="1500"/>
                                                        <ComboBoxItem Content="3 秒" Tag="3000"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="SettingsPanelResilience" Visibility="Collapsed">
                                <Border Style="{StaticResource SectionCard}" Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="断线与续跑" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"
                                                       ToolTip="断线可重试或换人。默认不抢鼠标键盘。"/>
                                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button x:Name="BtnDismissStuckModalsNow" Style="{StaticResource IconToolBtn}" Margin="0,0,6,0"
                                                        AutomationProperties.Name="清理卡住弹窗"
                                                        ToolTip="在后台静默关闭外部 AI 客户端残留的阻塞模态窗（不抢鼠标键盘）"
                                                        Click="BtnDismissStuckModalsNow_Click">
                                                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M5,19 H19 M8,19 L10,7 H14 L16,19 M12,7 V4 M9,4 H15"/>
                                                </Button>
                                                <Button x:Name="BtnProbeNetworkNow" Style="{StaticResource IconToolBtn}" Margin="0,0,6,0"
                                                        AutomationProperties.Name="检测网络" ToolTip="检测网络" Click="BtnProbeNetworkNow_Click">
                                                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4" Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M4,16 C7,12 17,12 20,16 M7,16 C9,14 15,14 17,16 M12,18.2 A1,1 0 1 0 12.01,18.2"/>
                                                </Button>
                                                <Button x:Name="BtnManualResumeFromSettings" Style="{StaticResource PrimaryBtn}" Padding="8,4"
                                                        ToolTip="从最近断点继续执行" Click="BtnResumeCheckpoint_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="12" Height="12" Stretch="Uniform" Stroke="#E0F2FE" StrokeThickness="1.5" VerticalAlignment="Center"
                                                              Data="M8,4 L16,10 L8,16 Z"/>
                                                        <TextBlock Text="续跑" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.15*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="0.85*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                                <StackPanel>
                                                    <CheckBox x:Name="ChkEnableNetRetry"
                                                              Content="断线自动重连"
                                                              ToolTip="断线或消息未送达时按指数退避重试。"
                                                              Foreground="#F1F5F9" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8"
                                                              Checked="NetworkResilienceSetting_Changed" Unchecked="NetworkResilienceSetting_Changed"/>
                                                    <CheckBox x:Name="ChkWaitLocalNetRecover"
                                                              Content="断网等待恢复"
                                                              ToolTip="本机网络掉线时自动挂起，网络恢复后再重发。"
                                                              Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,8"
                                                              Checked="NetworkResilienceSetting_Changed" Unchecked="NetworkResilienceSetting_Changed"/>
                                                    <CheckBox x:Name="ChkEnableAgentFailover"
                                                              Content="故障自动换 AI"
                                                              ToolTip="单个 AI 服务器持续故障时，自动切换其他已启用 AI 接力。"
                                                              Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,8"
                                                              Checked="NetworkResilienceSetting_Changed" Unchecked="NetworkResilienceSetting_Changed"/>
                                                    <CheckBox x:Name="ChkAutoResumeOnNetRecover"
                                                              Content="联网后自动续跑"
                                                              ToolTip="长时间断网中断后，检测到网络重新连通时自动后台续跑。"
                                                              Foreground="#94A3B8" FontSize="12"
                                                              Checked="NetworkResilienceSetting_Changed" Unchecked="NetworkResilienceSetting_Changed"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                                <StackPanel>
                                                    <TextBlock Text="重连次数" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"
                                                               ToolTip="单轮最大自动重连尝试次数"/>
                                                    <ComboBox x:Name="ComboMaxNetRetries" Margin="0,0,0,8" SelectionChanged="ComboNetworkResilience_SelectionChanged">
                                                        <ComboBoxItem Content="2 次" Tag="2"/>
                                                        <ComboBoxItem Content="3 次" Tag="3"/>
                                                        <ComboBoxItem Content="5 次" Tag="5"/>
                                                        <ComboBoxItem Content="8 次" Tag="8"/>
                                                    </ComboBox>
                                                    <TextBlock Text="超时" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"
                                                               ToolTip="单次执行无响应超时阈值"/>
                                                    <ComboBox x:Name="ComboSingleTimeout" Margin="0,0,0,8" SelectionChanged="ComboNetworkResilience_SelectionChanged">
                                                        <ComboBoxItem Content="120 秒" Tag="120"/>
                                                        <ComboBoxItem Content="180 秒" Tag="180"/>
                                                        <ComboBoxItem Content="300 秒" Tag="300"/>
                                                    </ComboBox>
                                                    <TextBlock Text="卡住时" Foreground="{StaticResource FgSecondaryBrush}" FontSize="12" Margin="0,0,0,3"
                                                               ToolTip="任务卡住或外部弹窗阻塞时的处理方式"/>
                                                    <ComboBox x:Name="ComboStallRecoveryPolicy" Margin="0,0,0,8" SelectionChanged="ComboNetworkResilience_SelectionChanged">
                                                        <ComboBoxItem Content="先重试，再问我" Tag="auto_then_ask"/>
                                                        <ComboBoxItem Content="立刻问我" Tag="ask_user_immediately"/>
                                                        <ComboBoxItem Content="全自动自愈" Tag="auto_self_heal"/>
                                                    </ComboBox>
                                                    <TextBlock x:Name="TextNetDiagStatus"
                                                               Text="网络正常"
                                                               FontSize="12" Foreground="#34D399" TextWrapping="Wrap"
                                                               ToolTip="网络实时诊断"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="SettingsPanelAbout" Visibility="Collapsed">
                                <Border Style="{StaticResource SectionCard}" Padding="16,14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="新手引导" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"
                                                   ToolTip="3 步认领本机 AI：扫描本机 AI、选定主脑和成员、开启悬浮窗。可随时重开。"/>
                                        <Button x:Name="BtnReopenOnboarding" Grid.Column="1" Content="重开向导" Style="{StaticResource PrimaryBtn}" Padding="14,7" FontSize="13" VerticalAlignment="Center" Click="BtnReopenOnboarding_Click" ToolTip="再看一遍 3 步新手向导"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SectionCard}" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="版本与更新" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"
                                                       ToolTip="顶栏版本号可随时检查。启动约 4 秒后后台静默检查一次，有新版才提示。"/>
                                            <Button x:Name="BtnCheckAppUpdate"
                                                    Grid.Column="1"
                                                    Content="检查"
                                                    Style="{StaticResource PrimaryBtn}"
                                                    Padding="14,6"
                                                    VerticalAlignment="Center"
                                                    ToolTip="从 AIDeck 官方 GitHub 发布源立即检查更新"
                                                    Click="BtnCheckAppUpdate_Click"/>
                                        </Grid>
                                        <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9">
                                            <StackPanel>
                                                <TextBlock x:Name="TextAboutCurrentVersion" Text="AIDeck · 多 AI 协同中心 v1.9.14" FontSize="13" FontWeight="SemiBold" Foreground="#E0F2FE" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="TextAppUpdateStatus" Text="尚未检查更新" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"
                                                           ToolTip="可手动检查，或等待启动后的后台静默检查。只有发现新版本才提示。"/>
                                                <TextBlock x:Name="LblUpdateRepoUrl" Text="更新源" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4" Visibility="Collapsed"
                                                           ToolTip="GitHub / Gitee 仓库、SSH、owner/repo，或自定义 JSON。留空则读取本地 Git origin。"/>
                                                <TextBox x:Name="TextUpdateRepoUrl" Height="28" FontSize="12" Padding="8,4" Margin="0,0,0,8" Visibility="Collapsed" LostFocus="TextUpdateRepoUrl_LostFocus"
                                                         ToolTip="例如 https://github.com/owner/repo 、git@gitee.com:owner/repo.git 或 https://example.com/latest.json"/>
                                                <CheckBox x:Name="ChkAutoCheckAppUpdate"
                                                          Content="启动后查更新"
                                                          ToolTip="启动后自动检查软件更新（后台执行，不阻塞界面）。有新版才提示。"
                                                          Foreground="#7DD3FC" FontSize="12"
                                                          Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SectionCard}" Padding="14,10">
                                    <Expander IsExpanded="False" Foreground="#E6EDF7" Background="Transparent">
                                        <Expander.Header>
                                            <TextBlock Text="高级与开发者" FontSize="13.5" FontWeight="SemiBold" Foreground="#9AA8BE" Margin="4,0,0,0"/>
                                        </Expander.Header>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock x:Name="AppUserDataPathText" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button Content="打开配置目录" Style="{StaticResource ActionBtn}" Margin="0,0,8,6" Click="BtnOpenUserDataDir_Click" ToolTip="打开个人数据目录"/>
                                                <Button x:Name="OpenRegistryDirBtn" Content="打开注册表目录" Style="{StaticResource ActionBtn}" Margin="0,0,8,6" Click="OpenRegistryDirBtn_Click" ToolTip="打开规则与检测器配置目录"/>
                                                <Button Content="打开聊天库" Style="{StaticResource ActionBtn}" Margin="0,0,8,6" Click="BtnOpenAiChatDir_Click" ToolTip="打开 F:\AIChat 跨工具聊天记录库"/>
                                                <Button x:Name="ExportShareZipBtn" Content="导出分享包" Style="{StaticResource AmberBtn}" Margin="0,0,8,6" Click="ExportShareZipBtn_Click" ToolTip="生成不含个人路径或聊天记录的绿色压缩包"/>
                                            </WrapPanel>
                                            <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock x:Name="StartupRegStatusTitle" Text="正在检查开机自启" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                                        <TextBlock x:Name="StartupRegCommandText" Text="" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Button x:Name="BtnVerifyStartupReg" Grid.Column="1" Content="核验注册表" Style="{StaticResource ActionBtn}" VerticalAlignment="Center" Click="BtnVerifyStartupReg_Click"/>
                                                </Grid>
                                            </Border>
                                            <CheckBox x:Name="ChkAutoTrustWorkspaces"
                                                      Content="自动信任工程"
                                                      ToolTip="自动信任已纳管工程目录，并为后台 CLI 附加 --trust / -f / --approve-mcps，避免交互拦截。"
                                                      Foreground="#7DD3FC" FontSize="12" Margin="0,0,0,8"
                                                      Checked="NetworkResilienceSetting_Changed" Unchecked="NetworkResilienceSetting_Changed"/>
                                            <CheckBox x:Name="ChkFloatingAutoExpand"
                                                      Content="自动展开已锁定"
                                                      IsEnabled="False" IsChecked="False"
                                                      Foreground="#64748B" FontSize="12" Margin="0,0,0,6"
                                                      ToolTip="形态只由手动切换，任务开始不会自动展开。"
                                                      Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                            <CheckBox x:Name="ChkFloatingAutoCollapse"
                                                      Content="自动收起已锁定"
                                                      IsEnabled="False" IsChecked="False"
                                                      Foreground="#64748B" FontSize="12"
                                                      ToolTip="任务完成后保持当前形态，不会自动收起。"
                                                      Checked="AppSettingCheckBox_Changed" Unchecked="AppSettingCheckBox_Changed"/>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderSectionBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="就绪 · 多 AI 协同工作流运行中" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                <TextBlock x:Name="RightDataPathText" Grid.Column="1" Visibility="Collapsed" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
