                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel x:Name="ActiveProfileSummaryBar" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="SettingsSaveHintText" Grid.Column="1"
