                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 双视角分段切换胶囊 -->
                                    <Border Grid.Column="0" Background="#0F1520" BorderBrush="#222D40" BorderThickness="1" CornerRadius="6" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadioViewByAgent" Content="按 AI 角色与能力总览" IsChecked="True"
                                                         GroupName="RosterRouteSwitch" Checked="RosterRouteView_Changed"
