                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewPitfallBox" Grid.Column="0"/>
                                    <Button x:Name="ArchiveTaskBtn" Grid.Column="1" Content="✓ 归档本轮任务" Style="{StaticResource SuccessBtn}" Margin="8,0,0,0" Click="ArchiveTaskBtn_Click"/>
                                </Grid>
                            </StackPanel>

                            <TextBox x:Name="TaskEditorBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12.5"/>
                        </DockPanel>
