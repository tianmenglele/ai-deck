                                        <ComboBoxItem Content="全部" Tag="all" IsSelected="True"/>
                                        <ComboBoxItem Content="Antigravity" Tag="antigravity"/>
                                        <ComboBoxItem Content="Codex" Tag="codex_cli"/>
                                        <ComboBoxItem Content="Cursor" Tag="cursor"/>
                                    </ComboBox>
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="DialogSearchBox" Padding="9,5,26,5" ToolTip="输入关键词筛选对话标题或 SessionId" TextChanged="DialogSearchBox_TextChanged"/>
