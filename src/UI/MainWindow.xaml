                                    </DockPanel>
                                    <WrapPanel x:Name="RouteOverviewLegendPanel" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="MagpieWorkRoutesPanel"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. 环境扩展信息（仅保留目录打开与只读未安装说明，严禁放任何未安装工具的 CLI 安装诱导按钮） -->
