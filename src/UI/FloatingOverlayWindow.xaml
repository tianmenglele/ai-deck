<Window x:Class="AICollabHub.UI.FloatingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="多 AI 协同桌面悬浮窗"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="420" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ThemeResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border x:Name="OuterFrame"
                Background="#FF0F1521"
                BorderBrush="#2A3F5F"
                BorderThickness="1.5"
                CornerRadius="12"
                Margin="0"
                Padding="8,8,8,8">

        <Grid x:Name="RootChromeGrid" ClipToBounds="False">
            <!-- ==================== 模式 A：收起态（一排小头像状态灯 + 一句话简报） ==================== -->
            <Border x:Name="CollapsedMiniCapsule"
                    Visibility="Collapsed"
                    Background="Transparent"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="CollapsedMiniCapsule_MouseLeftButtonDown"
                    MouseLeftButtonUp="DragHeaderBar_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="CapsuleAvatarsPanel"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="0,0,4,0"/>

                    <!-- 任务摘要改为 ToolTip，极简胶囊不占横向空间 -->
                    <TextBlock x:Name="CapsuleBriefText"
                               Visibility="Collapsed"
                               Width="0"
                               Height="0"
                               Text=""
                               FontSize="11"
                               Foreground="#E2E8F0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CapsuleSoundBtn"
                                Content="🔔"
                                Style="{StaticResource ActionBtn}"
                                Padding="4,1"
                                FontSize="10.5"
                                Margin="0,0,2,0"
                                ToolTip="点击切换音效模式：全音效 / 仅完成音 / 静音"
                                Click="QuickSoundBtn_Click"/>
                        <Button x:Name="CapsuleOpacityBtn"
                                Content="◐"
                                Style="{StaticResource ActionBtn}"
                                Padding="4,1"
                                FontSize="10.5"
                                Margin="0,0,2,0"
                                ToolTip="点击展开手动调节透明度（或在此按钮上直接滚动鼠标滚轮调节 25%~100%）"
                                MouseWheel="OpacityControl_MouseWheel"
                                Click="CapsuleOpacityBtn_Click"/>
                        <Button x:Name="CapsuleExpandBtn"
                                Content="▾"
                                Style="{StaticResource PrimaryBtn}"
                                Padding="5,1"
                                Margin="0"
                                FontSize="11"
                                ToolTip="展开查看每个 AI 的实时任务状态（也可双击胶囊）"
                                Click="CollapseToggleBtn_Click"/>
                        <Button x:Name="CapsuleMainBtn"
                                Visibility="Collapsed"
                                Content="🖥"
                                Style="{StaticResource ActionBtn}"
                                Padding="5,1"
                                FontSize="10.5"
                                ToolTip="恢复打开主程序窗口"
                                Click="OpenMainBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 模式 B：展开态 ==================== -->
            <Grid x:Name="ExpandedFullContainer" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="AgentsRowDef" Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="DragHeaderBar"
                        Grid.Row="0"
                        Background="#151F30"
                        BorderBrush="#24354F"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="DragHeaderBar_MouseLeftButtonDown"
                        MouseLeftButtonUp="DragHeaderBar_MouseLeftButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="HeaderPulseDot" Grid.Column="0" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeaderTitleText" Grid.Column="1" Text="AI 协同动态" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            <Border x:Name="HeaderProjBadgeHost" Grid.Column="2" Visibility="Collapsed" HorizontalAlignment="Left" Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderProjBadge" Text="" FontSize="10.5" Foreground="#7DD3FC" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <StackPanel x:Name="HeaderLegendDots"
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="7,0,0,0"
                                        Cursor="Hand"
                                        ToolTip="点击播放状态流转演示：📋派单 → 📦交付 → ✅主脑验收通过&#x0a;图例：紫=派单 / 青=接单 / 橙=实操 / 黄=验收 / 绿=交付">
                                <Ellipse Width="7" Height="7" Fill="#A855F7" Margin="0,0,2.5,0"/>
                                <Ellipse Width="7" Height="7" Fill="#38BDF8" Margin="0,0,2.5,0"/>
                                <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,2.5,0"/>
                                <Ellipse Width="7" Height="7" Fill="#FBBF24" Margin="0,0,2.5,0"/>
                                <Ellipse Width="7" Height="7" Fill="#10B981"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="HeaderSoundBtn" Content="🔔" Style="{StaticResource ActionBtn}" Padding="5,1" FontSize="10.5" Margin="0,0,3,0" ToolTip="点击切换音效模式：全音效 / 仅完成音 / 静音" Click="QuickSoundBtn_Click"/>
                            <Button x:Name="HeaderWorkflowBtn" Content="🟢" Style="{StaticResource ActionBtn}" Padding="5,1" FontSize="10.5" Margin="0,0,3,0" ToolTip="协同工作流已开启（点击切换启停：关闭后所有 AI 恢复原生独立模式）" Click="HeaderWorkflowBtn_Click"/>
                            <Button x:Name="LayoutModeBtn" Style="{StaticResource ActionBtn}" Padding="6,3" Margin="0,0,3,0" ToolTip="点击循环切换视图密度：宽松完整 ➔ 紧凑双行 ➔ 极简单行" Click="LayoutModeBtn_Click"/>
                            <Button x:Name="TranslucentBtn" Content="◐" Style="{StaticResource ActionBtn}" Padding="6,1" FontSize="11" Margin="0,0,3,0" ToolTip="调节透明度（点击弹出纵向滑块，上下拖动实时生效，点击外部自动关闭保存）" MouseWheel="OpacityControl_MouseWheel" Click="TranslucentBtn_Click"/>
                            <Button x:Name="CollapseToggleBtn" Content="▴" Style="{StaticResource ActionBtn}" Padding="6,1" FontSize="11" Margin="0,0,3,0" ToolTip="收起为单行头像胶囊（也可双击标题栏）" Click="CollapseToggleBtn_Click"/>
                            <Button x:Name="OpenSettingsBtn" Content="⚙" Style="{StaticResource ActionBtn}" Padding="5,1" FontSize="10.5" Margin="0,0,0,0" ToolTip="打开设置（开机自启 / 悬浮窗设置）" Click="OpenSettingsBtn_Click"/>
                            <Button x:Name="OpenMainBtn" Visibility="Collapsed" Content="🖥" Style="{StaticResource PrimaryBtn}" Padding="6,1" FontSize="10.5" Margin="0,0,0,0" ToolTip="恢复打开主程序面板" Click="OpenMainBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ActivePolicyStrip"
                        Grid.Row="1"
                        Background="#111A2B"
                        BorderBrush="#1E2D45"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,3"
                        Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎯 总策略:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Border Grid.Column="1" Background="#162840" BorderBrush="#264773" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderPolicyText" Text="省主脑额度（Cursor 主力开发）" FontSize="11" FontWeight="SemiBold" Foreground="#7DD3FC" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBlock x:Name="HeaderPolicyMetaText" Grid.Column="2" Text="主脑 Antigravity" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="FloatingAgentsScroller"
                              Grid.Row="2"
                              Margin="0,5,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                    <StackPanel x:Name="FloatingAgentsStack"/>
                </ScrollViewer>
            </Grid>

            <!-- 暗夜翡翠玻璃拟态完成气泡：宽度独立于折叠胶囊，按屏幕空间挂在悬浮窗上或下 -->
            <Popup x:Name="VerifyCelebrationPopup"
                   PlacementTarget="{Binding ElementName=OuterFrame}"
                   Placement="Custom"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   PopupAnimation="None"
                   IsHitTestVisible="True">
                <Border x:Name="VerifyCelebrationBanner"
                        Width="324"
                        MinWidth="310"
                        MaxWidth="348"
                        Visibility="Collapsed"
                        Opacity="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        UseLayoutRounding="False"
                        SnapsToDevicePixels="False"
                        RenderTransformOrigin="0.5,0"
                        IsHitTestVisible="True"
                        MouseEnter="VerifyCelebrationBanner_MouseEnter"
                        MouseLeave="VerifyCelebrationBanner_MouseLeave">
                    <Border.Effect>
                        <DropShadowEffect Color="#04140F" BlurRadius="18" ShadowDepth="3" Opacity="0.58" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Path x:Name="VerifyBubbleTailTop"
                              Grid.Row="0"
                              Width="16"
                              Height="8"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Margin="154,0,0,-1"
                              Stretch="Fill"
                              Fill="#F20A1E1A"
                              Stroke="#6634D399"
                              StrokeThickness="1"
                              StrokeLineJoin="Round"
                              Data="M0,8 L8,0.5 L16,8 Z"
                              IsHitTestVisible="False"/>

                        <Border Grid.Row="1"
                                CornerRadius="12"
                                BorderBrush="#6634D399"
                                BorderThickness="1"
                                Padding="12,9,10,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F20A1E1A" Offset="0"/>
                                    <GradientStop Color="#F20C1826" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#6634D399" Offset="0"/>
                                                    <GradientStop Color="#1A34D399" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Stroke="#8834D399" StrokeThickness="1" Fill="Transparent"/>
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Stroke="#6EE7B7" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Fill="Transparent"
                                              Data="M3.2,6.4 L5.2,8.5 L8.8,3.6"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                                    </Grid>
                                    <TextBlock x:Name="VerifyCelebrationTitle"
                                               Grid.Column="1"
                                               Text="主脑验收通过 · 已交付"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="#ECFDF5"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="2"
                                            Background="#1434D399"
                                            BorderBrush="#5534D399"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="6,1"
                                            Margin="6,0,4,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="VerifyCelebrationAgentBadge"
                                                   Text="Cursor"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#A7F3D0"/>
                                    </Border>
                                    <Button x:Name="BtnDismissVerifyBubble"
                                            Grid.Column="3"
                                            Width="18"
                                            Height="18"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            IsHitTestVisible="True"
                                            ToolTip="关闭"
                                            VerticalAlignment="Center"
                                            Click="BtnDismissVerifyBubble_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="DismissBd" Background="Transparent" CornerRadius="4" Width="18" Height="18">
                                                    <Path Width="9" Height="9" Stretch="Uniform"
                                                          Stroke="#A7F3D0" StrokeThickness="1.35"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M1.5,1.5 L7.5,7.5 M7.5,1.5 L1.5,7.5"
                                                          IsHitTestVisible="False"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DismissBd" Property="Background" Value="#2A34D399"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <Border Height="1" Background="#2634D399" Margin="0,7,0,6"/>
                                <TextBlock x:Name="VerifyCelebrationContent"
                                           Text="任务已达标交付"
                                           FontSize="12"
                                           Foreground="#D1FAE5"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="34"
                                           LineHeight="16"
                                           LineStackingStrategy="BlockLineHeight"/>
                                <TextBlock x:Name="VerifyCelebrationText"
                                           Visibility="Collapsed"
                                           FontSize="12"
                                           Height="0"
                                           Text=""/>
                                <Border x:Name="VerifyBubbleProgressTrack"
                                        Height="2.5"
                                        Margin="0,8,0,1"
                                        CornerRadius="1.25"
                                        Background="#1F34D399"
                                        ClipToBounds="True">
                                    <Border x:Name="VerifyBubbleProgressFill"
                                            Height="2.5"
                                            Width="292"
                                            HorizontalAlignment="Left"
                                            CornerRadius="1.25"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#10B981" Offset="0"/>
                                                <GradientStop Color="#6EE7B7" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="VerifyBubbleProgressScale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Path x:Name="VerifyBubbleTailBottom"
                              Grid.Row="2"
                              Width="16"
                              Height="8"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="154,-1,0,0"
                              Stretch="Fill"
                              Visibility="Collapsed"
                              Fill="#F20C1826"
                              Stroke="#6634D399"
                              StrokeThickness="1"
                              StrokeLineJoin="Round"
                              Data="M0,0 L8,7.5 L16,0 Z"
                              IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Popup>

            <!-- 飞行交互动画层（禁用像素取整保证亚像素丝滑运动，不抢焦点/不挡点击） -->
            <Canvas x:Name="InteractionFxCanvas"
                    UseLayoutRounding="False"
                    SnapsToDevicePixels="False"
                    IsHitTestVisible="False"
                    ClipToBounds="False"
                    Panel.ZIndex="50"/>

            <!-- 右边缘缩放（已禁用，固定标准宽度并彻底消除鼠标边缘切换光标） -->
            <Thumb x:Name="ResizeThumbRight"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   Width="6"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   Margin="0,-2,-4,-2"
                   Cursor="Arrow"
                   Opacity="0.01"
                   Background="#01000000"
                   DragDelta="ResizeThumbRight_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted"
                   Panel.ZIndex="60"/>

            <!-- 下边缘缩放（已禁用，高度完全随视图模式全/紧/简自适应） -->
            <Thumb x:Name="ResizeThumbBottom"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   Height="6"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Bottom"
                   Margin="-2,0,-2,-4"
                   Cursor="SizeNS"
                   Opacity="0.01"
                   Background="#01000000"
                   DragDelta="ResizeThumbBottom_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted"
                   Panel.ZIndex="60"/>

            <!-- 右下角斜纹抓手（已隐藏，仅保留右缘调宽） -->
            <Thumb x:Name="ResizeThumbCorner"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   Width="16"
                   Height="16"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,-3,-3"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeThumbCorner_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted"
                   MouseDoubleClick="ResizeThumbCorner_MouseDoubleClick"
                   Panel.ZIndex="70"
                   ToolTip="拖拽调整宽高；双击恢复默认自适应高度">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Stroke="#64748B"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0.85"
                                  Data="M 4,14 L 14,4 M 8,14 L 14,8 M 12,14 L 14,12"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- 透明度弹出滑块 -->
            <Popup x:Name="OpacityPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=TranslucentBtn}"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   VerticalOffset="4"
                   HorizontalOffset="-6"
                   Closed="OpacityPopup_Closed">
                <Border Background="#F5111927"
                        BorderBrush="#38BDF8"
                        BorderThickness="1.2"
                        CornerRadius="10"
                        Padding="7,8,7,8"
                        Margin="6"
                        MouseWheel="OpacityControl_MouseWheel">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.6"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center" Width="34">
                        <TextBlock x:Name="InlineOpacityValueText"
                                   Text="96%"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#7DD3FC"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <Slider x:Name="InlineOpacitySlider"
                                Orientation="Vertical"
                                Height="108"
                                Minimum="25"
                                Maximum="100"
                                SmallChange="2"
                                LargeChange="10"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                HorizontalAlignment="Center"
                                ValueChanged="InlineOpacitySlider_ValueChanged"/>
                        <TextBlock Text="◐"
                                   FontSize="10.5"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Popup>

            <Border x:Name="PreviewPopupMirror"
                    Visibility="Collapsed"
                    Panel.ZIndex="99"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,28,88,0"
                    Background="#F5111927"
                    BorderBrush="#38BDF8"
                    BorderThickness="1.2"
                    CornerRadius="10"
                    Padding="7,8,7,8">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.65"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" Width="34">
                    <TextBlock x:Name="PreviewOpacityValueText"
                               Text="96%"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#7DD3FC"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <Slider x:Name="PreviewOpacitySlider"
                            Orientation="Vertical"
                            Height="96"
                            Minimum="25"
                            Maximum="100"
                            Value="96"
                            HorizontalAlignment="Center"/>
                    <TextBlock Text="◐"
                               FontSize="10.5"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
