<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AI协同中心</AssemblyName>
    <RootNamespace>AICollabHub</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>1.9.15</Version>
    <AssemblyVersion>1.9.15.0</AssemblyVersion>
    <FileVersion>1.9.15.0</FileVersion>
    <InformationalVersion>1.9.15</InformationalVersion>
    <Product>AIDeck · 多 AI 协同配置中心</Product>
    <Description>AIDeck（推荐 Git 仓库名 ai-deck）：Windows 通用多项目 AI 协同检测、分工路由、规则技能零拷贝同步与桌面置顶悬浮窗工具</Description>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\icons\*.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Sounds\dispatch_flight.wav" LogicalName="AICollabHub.Assets.Sounds.dispatch_flight.wav" />
    <EmbeddedResource Include="Assets\Sounds\status_change.wav" LogicalName="AICollabHub.Assets.Sounds.status_change.wav" />
    <EmbeddedResource Include="Assets\Sounds\work_started.wav" LogicalName="AICollabHub.Assets.Sounds.work_started.wav" />
    <EmbeddedResource Include="Assets\Sounds\task_completed.wav" LogicalName="AICollabHub.Assets.Sounds.task_completed.wav" />
    <EmbeddedResource Include="Assets\Sounds\verify_passed.wav" LogicalName="AICollabHub.Assets.Sounds.verify_passed.wav" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\registry\detectors.json" LogicalName="AICollabHub.Embedded.registry.detectors.json" />
    <EmbeddedResource Include="..\registry\adapters.json" LogicalName="AICollabHub.Embedded.registry.adapters.json" />
    <EmbeddedResource Include="..\registry\capability_tags.json" LogicalName="AICollabHub.Embedded.registry.capability_tags.json" />
    <EmbeddedResource Include="..\registry\workflows.json" LogicalName="AICollabHub.Embedded.registry.workflows.json" />
    <EmbeddedResource Include="..\registry\project_presets.json" LogicalName="AICollabHub.Embedded.registry.project_presets.json" />
    <EmbeddedResource Include="..\plugins\export_config_digest.ps1" LogicalName="AICollabHub.Embedded.plugins.export_config_digest.ps1" />
    <EmbeddedResource Include="..\启动协同中心.ps1" LogicalName="AICollabHub.Embedded.启动协同中心.ps1" />
  </ItemGroup>
</Project>
